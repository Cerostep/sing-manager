install_wrapplus() {
    if ! command -v warp-cli &> /dev/null; then
        log_error "warp-cli is not installed"
        return 1
    fi
    if warp-cli status 2>> "$LOG_FILE" | grep -qi "Connected"; then
        log_info "Cloudflare WARP is already connected"
        return 0
    fi
    if ! warp-cli registration show >> "$LOG_FILE" 2>&1; then
        if ! run_step "Cloudflare WARP registered" "Failed to register Cloudflare WARP" \
            warp-cli registration new --accept-tos; then
            return 1
        fi
    fi
    run_step "Cloudflare WARP proxy mode configured" "Failed to set Cloudflare WARP proxy mode" \
        warp-cli mode proxy || return 1
    run_step "Cloudflare WARP proxy port configured" "Failed to configure Cloudflare WARP proxy port" \
        warp-cli proxy port 40000 || return 1
    run_step "Cloudflare WARP connected" "Failed to connect Cloudflare WARP" \
        warp-cli connect || return 1
    run_logged warp-cli status
}

install_sing_box() {
    local current_version=""
    local service_file="/etc/systemd/system/sing-box.service"
    local service_status="missing"
    local version_matches="false"

    log_info "Preparing to install sing-box..."

    if command -v sing-box &> /dev/null &&
        current_version=$(sing-box version 2>> "$LOG_FILE") &&
        [[ -n "$current_version" ]]; then
        if [[ "$current_version" =~ (^|[[:space:]])${SING_BOX_VERSION//./\\.}([[:space:]]|$) ]]; then
            version_matches="true"
            log_warn "Supported sing-box version already installed (version: $current_version)"
        else
            log_warn "Installed sing-box version is unsupported; version $SING_BOX_VERSION is required"
        fi

        if [[ -s "$service_file" ]]; then
            if systemctl is-active --quiet sing-box; then
                service_status="active"
            elif systemctl is-failed --quiet sing-box; then
                service_status="failed"
            else
                service_status="inactive"
            fi
        fi
        log_info "sing-box systemd service status: $service_status"

        if [[ "$INSTALL_REPAIR_MODE" == "true" && "$version_matches" == "true" ]]; then
            log_info "Repair mode: reusing the working sing-box binary and repairing the service/configuration"
            return 0
        fi

        if [[ "$INSTALL_REPAIR_MODE" != "true" && "$version_matches" == "true" ]]; then
            read -p "Reinstall or update sing-box? (Y/n) " -n 1 -r
            echo
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                log_info "Skipping sing-box binary installation (already installed)"
                return 0
            fi
        fi
    else
        log_warn "sing-box binary is missing or not working; installing it"
    fi

    log_info "Installing sing-box (version: $SING_BOX_VERSION)..."

    if curl -fsSL "$SING_BOX_INSTALL_URL" | sh -s -- --version "$SING_BOX_VERSION" >> "$LOG_FILE" 2>&1; then
        log_info "sing-box installer executed"
    else
        log_error "sing-box installation failed"
        return 1
    fi

    if command -v sing-box &> /dev/null; then
        local installed_version=$(sing-box version 2>/dev/null | head -n1)
        if [[ ! "$installed_version" =~ (^|[[:space:]])${SING_BOX_VERSION//./\\.}([[:space:]]|$) ]]; then
            log_error "Installer did not install the required sing-box version $SING_BOX_VERSION"
            return 1
        fi
        log_success "sing-box installed (version: $installed_version)"
    else
        log_error "sing-box executable not found after installation"
        return 1
    fi

}

generate_sg_config() {
    log_info "Generating Reality keypair..."
    if sing-box generate reality-keypair > /etc/sing-box/reality-keypair.txt 2>> "$LOG_FILE"; then
        log_success "Reality keypair generated"
    else
        log_error "Failed to generate Reality keypair"
        return 1
    fi

    log_info "Generating UUID..."
    if sing-box generate uuid > /etc/sing-box/uuid.txt 2>> "$LOG_FILE"; then
        log_success "UUID generated"
    else
        log_error "Failed to generate UUID"
        return 1
    fi
    chmod 600 /etc/sing-box/reality-keypair.txt /etc/sing-box/uuid.txt

    short_id=$(openssl rand -hex 8) || return 1
    printf '%s\n' "$short_id" > /etc/sing-box/short_id.txt
    private_key=$(cat /etc/sing-box/reality-keypair.txt | grep "PrivateKey" | awk -F': ' '{print $2}')
    public_key=$(cat /etc/sing-box/reality-keypair.txt | grep "PublicKey" | awk -F': ' '{print $2}')
    uuid=$(cat /etc/sing-box/uuid.txt)
    
    echo -e "${YELLOW}[Reality Configuration]${NC}"
    echo "Configure Reality server name and handshake target:"
    
    if [[ ${SELF_BACKEND} == "true" ]]; then
        handshake_server="127.0.0.1"
        handshake_port="18443"
        server_name="$SELF_DOMAIN"
        log_info "Reality handshake target set to: $handshake_server:$handshake_port (self-hosted)"
    else
        handshake_server="cdnjs.cloudflare.com"
        handshake_port="443"
        server_name="cdnjs.cloudflare.com"
        log_info "Using default Reality handshake target $handshake_server:$handshake_port"
    fi
    echo ""
    echo -e "${YELLOW}[VLESS Configuration]${NC}"
    echo "  • Reality short ID: $short_id"
    echo "  • Reality public key: $public_key"
    echo "  • UUID: $uuid"
    echo "  • TLS server name: $server_name"
    echo "  • Reality handshake target: $handshake_server:$handshake_port"
    create_vless_json /etc/sing-box/vless.json || return 1
    rm -f /etc/sing-box/config.json >> "$LOG_FILE" 2>&1 || return 1
    ln -sf /etc/sing-box/vless.json /etc/sing-box/config.json || return 1
    log_info "VLESS configuration linked"
    
    log_success "sing-box configuration created with variables"
}

generate_qr_svg() {
    local content=$1
    local output_file=$2
    local temporary_file

    temporary_file=$(mktemp "${output_file}.XXXXXX") || {
        log_error "Failed to create a temporary QR file"
        return 1
    }
    if ! run_logged qrencode -t ANSIUTF8 -m 1 -l L -o "$temporary_file" "$content"; then
        rm -f "$temporary_file"
        log_error "Failed to generate QR code"
        return 1
    fi
    if ! run_logged mv -f "$temporary_file" "$output_file"; then
        rm -f "$temporary_file"
        log_error "Failed to save QR code to $output_file"
        return 1
    fi
}

generate_subscription() {
    log_info "Generating VLESS subscription link..."

    if [[ ! -f /etc/sing-box/config.json ]]; then
        log_error "Config file not found: /etc/sing-box/config.json"
        return 1
    fi

    local uuid flow port sni pbk sid server_addr vless_url
    uuid=$(jq -r '.inbounds[0].users[0].uuid' /etc/sing-box/config.json 2>/dev/null)
    flow=$(jq -r '.inbounds[0].users[0].flow' /etc/sing-box/config.json 2>/dev/null)
    port=$(jq -r '.inbounds[0].listen_port' /etc/sing-box/config.json 2>/dev/null)
    sni=$(jq -r '.inbounds[0].tls.server_name' /etc/sing-box/config.json 2>/dev/null)
    pbk=$(awk -F': ' '/^PublicKey: / {print $2}' /etc/sing-box/reality-keypair.txt)
    sid=$(jq -r '.inbounds[0].tls.reality.short_id[0]' /etc/sing-box/config.json 2>/dev/null)

    if [[ -z "$uuid" || -z "$port" || "$uuid" == "null" || "$port" == "null" ]]; then
        log_error "Failed to read VLESS parameters from config"
        return 1
    fi
    if ! server_addr=$(resolve_client_server_addr); then
        log_error "Could not resolve the client connection address"
        return 1
    fi
    if ! is_valid_client_server_address "$server_addr"; then
        log_error "Client connection address was not resolved to a valid IPv4 address or domain"
        return 1
    fi
    vless_url="vless://${uuid}@${server_addr}:${port}?encryption=none&flow=${flow}&type=none&security=reality&pbk=${pbk}&sid=${sid}&sni=${sni}&fp=chrome#VLESS"

    echo ""
    echo -e "${GREEN}════════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}VLESS Subscription Link${NC}"
    echo -e "${GREEN}════════════════════════════════════════════════════════${NC}"
    echo ""
    echo "Link: $vless_url"
    echo ""
    echo "Details:"
    echo "  • UUID: $uuid"
    echo "  • Server: $sni"
    echo "  • Port: $port"
    echo "  • Public key (pbk): $pbk"
    echo "  • Short ID (sid): $sid"
    echo "  • Flow: $flow"
    echo "  • Reality handshake target: $handshake_server:$handshake_port"
    echo ""

    printf '%s\n' "$vless_url" > /etc/sing-box/vless-subscription.txt || return 1
    generate_qr_svg "$vless_url" /etc/sing-box/vless-qr.svg || return 1
    log_success "VLESS subscription QR saved under /etc/sing-box"
    echo ""
}

setup_sing_box_service() {
    log_info "Configuring sing-box systemd service..."

    if [[ ! -d /etc/sing-box ]]; then
        log_warn "Directory /etc/sing-box not found, skipping service configuration"
        return 0
    fi

    local service_file="/etc/systemd/system/sing-box.service"
    local service_action

    log_info "Installing sing-box systemd service file..."
    if ! cat > "$service_file" << 'SYSTEMD_EOF'
[Unit]
Description=sing-box service
Documentation=https://sing-box.sagernet.org
After=network.target nss-lookup.target network-online.target

[Service]
User=sing-box
StateDirectory=sing-box
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
ExecStart=/usr/bin/sing-box -D /var/lib/sing-box -c /etc/sing-box/config.json run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
LimitNOFILE=infinity
Type=simple

[Install]
WantedBy=multi-user.target
SYSTEMD_EOF
    then
        log_error "Failed to write sing-box systemd service file"
        return 1
    fi
    if ! chmod 644 "$service_file" || ! run_logged systemctl daemon-reload; then
        log_error "Failed to install or reload sing-box systemd service"
        return 1
    fi
    log_success "sing-box systemd service file installed"

    if [[ -f /etc/sing-box/config.json ]]; then
        local log_file=$(jq -r '.log.output' /etc/sing-box/config.json 2>/dev/null || echo "")
        if [[ -n "$log_file" ]]; then
            touch "$log_file" 2>/dev/null || true
            chown sing-box:sing-box "$log_file" 2>/dev/null || true
            log_info "Log file configured: $log_file"
        fi
    fi
    
    chown root:root "$service_file" 2>/dev/null || true

    read -p "Enable and start sing-box service? (Y/n) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        log_info "Enabling sing-box autostart..."
        if systemctl enable sing-box >> "$LOG_FILE" 2>&1; then
            log_info "sing-box enabled for autostart"
        else
            log_warn "Failed to enable sing-box autostart"
        fi

        if [[ "$INSTALL_REPAIR_MODE" == "true" ]]; then
            log_info "Restarting sing-box service with repaired configuration..."
            service_action="restart"
        elif systemctl is-active --quiet sing-box; then
            log_info "Restarting sing-box service to apply the updated configuration..."
            service_action="restart"
        else
            log_info "Starting sing-box service..."
            service_action="start"
        fi
        if systemctl "$service_action" sing-box >> "$LOG_FILE" 2>&1; then
            log_info "sing-box $service_action command sent"
            sleep 2
            if systemctl is-active --quiet sing-box; then
                log_success "sing-box service is running"
            else
                log_error "sing-box service failed to run"
                log_info "Run 'journalctl -u sing-box -n 50' to view logs"
                return 1
            fi
        else
            log_error "Failed to $service_action sing-box service"
            log_info "Check configuration under /etc/sing-box/"
            return 1
        fi
    else
        log_info "sing-box service start skipped by user"
    fi
}

setup_permissions() {
