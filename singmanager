    echo ""
    
    if [[ "$ENABLE_WARPPLUS" == "true" ]]; then
    WRAPPLUS_OUTBOUND='{
            "type": "socks",
            "tag": "warpplus-out",
            "server": "127.0.0.1",
            "server_port": 40000,
            "version": "5",
            "username": null,
            "password": null,
            "network": "tcp",
            "udp_over_tcp": true
        },'
    else
        # WRAPPLUS_OUTBOUND is empty when not enabled.
        # fake outbound
        WRAPPLUS_OUTBOUND='{
            "tag": "warpplus-out",
            "type": "direct"
        },'
    fi
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}Installation cancelled by user${NC}"
        return 0
    fi
    echo ""

    echo "Installation log: $LOG_FILE"
    echo ""

    check_system || return 1
    update_package_manager || return 1
    install_dependencies || return 1
    create_sing_box_deps || return 1
    if [[ "$ENABLE_WARPPLUS" == "true" ]]; then
        install_wrapplus || return 1
    fi
    install_sing_box || return 1
    generate_sg_config || return 1
    install_nginx_config_files || return 1
    validate_nginx_config || return 1
    setup_permissions || return 1
    setup_nginx_service || return 1
    generate_subscription || return 1
    setup_sing_box_service || return 1
    install_singmanager_command || return 1
    touch /etc/sing-box/installation_complete.flag || {
        log_error "Failed to record installation completion"
        return 1
    }
    log_success "Installation completed successfully"

    display_subscription_qr
}

