#!/bin/bash

################################################################################
# singmanager - Unified installation and service management tool
# Purpose: Install and manage sing-box and nginx services
# Usage: sudo ./singmanager; after installation, run sudo singmanager
# Features:
#   - Idempotent installation and command setup in /usr/local/bin
#   - Interactive service management
#   - VLESS subscription QR code (256x256 px SVG)
#   - Complete logging to /tmp/install.log
################################################################################

set -o pipefail

# ============================================================================
# User configuration
# Edit the values in this section before running the script.  Configuration is
# intentionally kept in this script; /etc/singmanager.conf is not read.
# ============================================================================
# Set to true to install and use Nginx as the self-hosted backend. [true/false]
SELF_BACKEND="false"

# Required only when SELF_BACKEND=true.  It must point to a GitHub Release
# archive containing nginx/nginx.conf and nginx/html/.
NGINX_RELEASE_URL="https://github.com/Cerostep/sing-manager/releases/download/v1.0.0/nginx.tar.gz"
# sing-box installer settings.
SING_BOX_VERSION_DEFAULT="1.13.8"
SING_BOX_INSTALL_URL="https://sing-box.app/install.sh"
# WRAPPLUS_OUTBOUND is an optional outbound configuration snippet for sing-box.
# through the Cloudflare WARP+ service.  It is enabled by default.  Set to "false" to disable.
ENABLE_WARPPLUS="true"

# Runtime paths and defaults
SERVER_ADDR=""
FAKE_SITE="cdnjs.cloudflare.com"
FAKE_SITE_PORT="443"
LOG_FILE="/tmp/install.log"
NGINX_CERT_FILE="/etc/nginx/ssl/fullchain.cer"
NGINX_KEY_FILE="/etc/nginx/ssl/private.key"
NGINX_CONFIG_VALID="false"

# Preserve terminal stderr for controlled messages; command diagnostics go only
# to the installation log.
exec 3>&2
exec 2>>"$LOG_FILE"

# ============================================================================
# Color definitions
# ============================================================================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

# ============================================================================
# Logging helpers
# ============================================================================
log_info() {
    local msg="[INFO] $1"
    echo -e "${BLUE}${msg}${NC}"
    echo "$(date '+%Y-%m-%d %H:%M:%S') ${msg}" >> "$LOG_FILE"
}

log_success() {
    local msg="[✓] $1"
    echo -e "${GREEN}${msg}${NC}"
    echo "$(date '+%Y-%m-%d %H:%M:%S') ${msg}" >> "$LOG_FILE"
}

log_warn() {
    local msg="[WARN] $1"
    echo -e "${YELLOW}${msg}${NC}"
    echo "$(date '+%Y-%m-%d %H:%M:%S') ${msg}" >> "$LOG_FILE"
}

log_error() {
    local msg="[ERROR] $1"
    echo -e "${RED}${msg}${NC}" >&3
    echo "$(date '+%Y-%m-%d %H:%M:%S') ${msg}" >> "$LOG_FILE"
}

# Keep command diagnostics out of the interactive UI while retaining them for
# troubleshooting. Callers are responsible for presenting a concise result.
run_logged() {
    "$@" >> "$LOG_FILE" 2>&1
}

run_step() {
    local success_message=$1
    local failure_message=$2
    shift 2

    if run_logged "$@"; then
        log_success "$success_message"
        return 0
    fi

    log_error "$failure_message"
    return 1
}

# ============================================================================
# UI Helper functions
# ============================================================================
print_header() {
    clear
    echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}           🔧 Sing-box  Manager${NC}"
    echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
    echo ""
}

show_startup_configuration() {
    echo -e "${BLUE}Main script configuration (edit the User configuration section at the top of this script)${NC}"
    echo -e "${RED}  • SELF_BACKEND: $SELF_BACKEND"
    echo -e "${GREEN}  • NGINX_RELEASE_URL: ${NGINX_RELEASE_URL:-Not configured}"
    echo -e "${RED}  • SING_BOX_VERSION_DEFAULT: $SING_BOX_VERSION_DEFAULT"
    echo -e "${GREEN}  • SING_BOX_INSTALL_URL: $SING_BOX_INSTALL_URL"
    echo -e "${RED}  • FAKE_SITE: $FAKE_SITE"
    echo -e "${GREEN}  • FAKE_SITE_PORT: $FAKE_SITE_PORT"
    echo -e "${RED}  • SERVER_ADDR: ${SERVER_ADDR:-Not configured}"
    echo -e "${GREEN}  • ENABLE_WARPPLUS: ${ENABLE_WARPPLUS:-false}"
    echo ""
}

confirm_startup_configuration() {
    print_header
    show_startup_configuration
    read -p "Have you configured the variables above and want to continue with the current values? (Y/n): " -n 1 -r
    echo ""

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        print_info "Please update the User configuration section at the top of the script and run it again."
        exit 0
    fi
}

print_menu() {
    echo -e "${BLUE}📋 Main Menu${NC}"
    echo ""
    echo -e "  ${GREEN}0${NC}) Install or repair proxy server (sing-box) and dependencies"
    echo -e "  ${GREEN}1${NC}) View sing-box service status"
    echo -e "  ${GREEN}2${NC}) Display subscription QR codes"
    echo -e "  ${GREEN}3${NC}) Service control (start/stop/restart)"
    echo -e "  ${GREEN}4${NC}) Exit"
    echo ""
}

installation_is_valid() {
    local config_file="/etc/sing-box/config.json"
    local vless_config_file="/etc/sing-box/vless.json"
    local service_file="/etc/systemd/system/sing-box.service"
    local subscription_file="/etc/sing-box/vless-subscription.txt"
    local qr_file="/etc/sing-box/vless-qr.svg"
    local required_commands=(curl wget openssl jq qrencode unzip)
    local required_command subscription_uuid root_home expected_fake_site
    local expected_fake_site_port expected_outbound_type
    local expected_port="443"
    local installed_port

    if [[ ! -f /etc/sing-box/installation_complete.flag ]]; then
        log_warn "Installation completion marker is missing"
        return 1
    fi
    if [[ ! -x /usr/bin/sing-box ]] || ! /usr/bin/sing-box version >> "$LOG_FILE" 2>&1; then
        log_warn "sing-box executable is missing from /usr/bin or not working"
        return 1
    fi
    for required_command in "${required_commands[@]}"; do
        if ! command -v "$required_command" &> /dev/null; then
            log_warn "Required dependency $required_command is missing"
            return 1
        fi
    done
    if [[ ! -L "$config_file" ]] ||
        [[ "$(readlink -- "$config_file" 2>/dev/null)" != "$vless_config_file" ]]; then
        log_warn "sing-box config.json does not link to the managed VLESS configuration"
        return 1
    fi
    if [[ ! -s "$config_file" ]] || ! /usr/bin/sing-box check -c "$config_file" >> "$LOG_FILE" 2>&1; then
        log_warn "sing-box configuration is missing or invalid"
        return 1
    fi
    if [[ "$SELF_BACKEND" == "true" ]]; then
        expected_fake_site="127.0.0.1"
        expected_fake_site_port=18443
    else
        expected_fake_site="${FAKE_SITE:-cdnjs.cloudflare.com}"
        expected_fake_site_port="${FAKE_SITE_PORT:-443}"
    fi
    if [[ "$ENABLE_WARPPLUS" == "true" ]]; then
        expected_outbound_type="socks"
    else
        expected_outbound_type="direct"
    fi
    if ! jq -e \
        --arg fake_site "$expected_fake_site" \
        --argjson fake_site_port "$expected_fake_site_port" \
        --arg outbound_type "$expected_outbound_type" \
        '.inbounds[0].type == "vless" and
         .inbounds[0].tls.server_name == $fake_site and
         .inbounds[0].tls.reality.enabled == true and
         .inbounds[0].tls.reality.handshake.server == $fake_site and
         .inbounds[0].tls.reality.handshake.server_port == $fake_site_port and
         (.inbounds[0].users[0].uuid | type == "string" and length > 0) and
         any(.outbounds[]; .tag == "warpplus-out" and .type == $outbound_type)' \
        "$config_file" >/dev/null 2>&1; then
        log_warn "sing-box configuration does not match the selected deployment settings"
        return 1
    fi
    installed_port=$(jq -r '.inbounds[0].listen_port' "$config_file" 2>/dev/null)
    if [[ "$installed_port" != "$expected_port" ]]; then
        log_warn "sing-box is listening on unexpected port ${installed_port:-unknown}; expected $expected_port"
        return 1
    fi
    if [[ ! -s "$service_file" ]] ||
        ! grep -Fq 'User=sing-box' "$service_file" ||
        ! grep -Fq 'ExecStart=/usr/bin/sing-box -D /var/lib/sing-box -c /etc/sing-box/config.json run' "$service_file"; then
        log_warn "sing-box systemd service unit is missing or incorrect"
        return 1
    fi
    if [[ ! -s "$subscription_file" ]] || ! grep -q '^vless://' "$subscription_file"; then
        log_warn "VLESS subscription file is missing or invalid"
        return 1
    fi
    subscription_uuid=$(jq -r '.inbounds[0].users[0].uuid' "$config_file")
    if ! grep -Fq "vless://${subscription_uuid}@" "$subscription_file" ||
        { [[ -n "$SERVER_ADDR" ]] && ! grep -Fq "@${SERVER_ADDR}:${installed_port}?" "$subscription_file"; }; then
        log_warn "VLESS subscription does not match the installed configuration"
        return 1
    fi
    if [[ ! -s "$qr_file" ]] ||
        ! grep -q '<svg width="256px" height="256px"' "$qr_file"; then
        log_warn "256x256 VLESS QR code is missing or invalid"
        return 1
    fi
    if [[ ! -x /usr/local/bin/singmanager ]] ||
        ! cmp -s "$(readlink -f -- "${BASH_SOURCE[0]}")" /usr/local/bin/singmanager; then
        log_warn "Installed /usr/local/bin/singmanager command is missing or outdated"
        return 1
    fi
    root_home=$(getent passwd root | cut -d: -f6)
    if [[ -z "$root_home" ]] || ! grep -Fq '/usr/local/bin' "$root_home/.bashrc"; then
        log_warn "Root user's .bashrc does not include /usr/local/bin"
        return 1
    fi
    if [[ "$SELF_BACKEND" == "true" ]] && ! command -v nginx &> /dev/null; then
        log_warn "Nginx is enabled but not installed"
        return 1
    fi
    if [[ "$SELF_BACKEND" == "true" ]] &&
        { [[ ! -s /etc/nginx/nginx.conf ]] || [[ ! -s /etc/nginx/conf.d/mask.conf ]]; }; then
        log_warn "Nginx is enabled but its main or site configuration is missing"
        return 1
    fi

    return 0
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

legacy_print_error() {
    echo -e "${RED}✗ $1${NC}" >&2
}

# Override the legacy definition above so controlled errors remain visible.
print_error() {
    echo -e "${RED}Error: $1${NC}" >&3
}

print_info() {
    echo -e "${BLUE}ℹ $1${NC}"
}

print_warn() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

read() {
    if [[ "${1:-}" == "-p" ]]; then
        local prompt="$2"
        shift 2
        printf '%s' "$prompt" >&3
        builtin read "$@"
    else
        builtin read "$@"
    fi
}

pause_menu() {
    echo ""
    read -p "Press Enter to continue..."
}

install_singmanager_command() {
    local source_path target_path="/usr/local/bin/singmanager"
    local root_home bashrc
    local path_line='case ":$PATH:" in *:/usr/local/bin:*) ;; *) export PATH="/usr/local/bin:$PATH" ;; esac'

    source_path=$(readlink -f -- "${BASH_SOURCE[0]}") || {
        log_error "Failed to resolve the singmanager script path"
        return 1
    }
    if ! run_logged install -d -m 755 /usr/local/bin; then
        log_error "Failed to create /usr/local/bin"
        return 1
    fi
    if [[ "$source_path" != "$target_path" ]]; then
        if ! run_logged install -m 755 "$source_path" "$target_path"; then
            log_error "Failed to install singmanager to $target_path"
            return 1
        fi
    elif ! run_logged chmod 755 "$target_path"; then
        log_error "Failed to make $target_path executable"
        return 1
    fi

    root_home=$(getent passwd root | cut -d: -f6)
    if [[ -z "$root_home" ]]; then
        log_error "Failed to determine the root user's home directory"
        return 1
    fi
    bashrc="$root_home/.bashrc"
    if ! run_logged touch "$bashrc"; then
        log_error "Failed to create $bashrc"
        return 1
    fi
    if ! grep -Fqx "$path_line" "$bashrc"; then
        if ! printf '\n%s\n' "$path_line" >> "$bashrc"; then
            log_error "Failed to add /usr/local/bin to PATH in $bashrc"
            return 1
        fi
    fi

    log_success "Installed /usr/local/bin/singmanager and configured $bashrc"
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        print_error "This script requires root privileges"
        echo "Run: sudo $0"
        exit 1
    fi
}

# ============================================================================
# Installation functions
# ============================================================================
check_system() {
    : > "$LOG_FILE"
    log_info "Installation started (SELF_BACKEND=$SELF_BACKEND)"
    log_info "Checking system environment..."

    if [[ ! -f /etc/debian_version ]]; then
        log_error "This script supports only Debian/Ubuntu systems"
        exit 1
    fi

    log_success "System check passed"
}

update_package_manager() {
    log_info "Updating package indices..."
    if apt-get update >> "$LOG_FILE" 2>&1; then
        log_success "Package indices updated"
    else
        log_error "Failed to update package indices"
        exit 1
    fi
}

install_dependencies() {
    log_info "Installing dependencies..."

    local packages=(
        "curl"
        "wget"
        "ca-certificates"
        "openssl"
        "jq"
        "qrencode"
        "unzip"
    )

    if [[ "${SELF_BACKEND}" == "true" ]]; then
        packages+=("nginx")
        log_info "SELF_BACKEND is true, nginx will be installed"
    else
        log_info "SELF_BACKEND is false, nginx installation skipped"
    fi

    for package in "${packages[@]}"; do
        if dpkg -l | grep -qw "$package" 2>/dev/null; then
            log_info "$package already installed (skipped)"
        else
            log_info "Installing $package..."
            if apt-get install -y "$package" >> "$LOG_FILE" 2>&1; then
                log_success "$package installed successfully"
            else
                log_error "Failed to install $package"
                exit 1
            fi
        fi
    done

    
    if [[ "${ENABLE_WARPPLUS}" == "true" ]]; then
        local warp_packages=( "gpg" "lsb-release" )
        for wp_package in "${warp_packages[@]}"; do
            if dpkg -l | grep -qw "$wp_package" 2>/dev/null; then
                log_info "$wp_package already installed (skipped)"
            else
                log_info "Installing $wp_package..."
                if apt-get install -y "$wp_package" >> "$LOG_FILE" 2>&1; then
                    log_success "$wp_package installed successfully"
                else
                    log_error "Failed to install $wp_package"
                    exit 1
                fi
            fi
        done
        if curl -fsSL https://pkg.cloudflareclient.com/pubkey.gpg | gpg --yes --dearmor --output /usr/share/keyrings/cloudflare-warp-archive-keyring.gpg >> "$LOG_FILE" 2>&1; then
            echo "deb [signed-by=/usr/share/keyrings/cloudflare-warp-archive-keyring.gpg] https://pkg.cloudflareclient.com/ $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/cloudflare-client.list
            log_success "Warp GPG key downloaded and converted"
        else
            log_error "Failed to download Warp GPG key"
            exit 1
        fi
        if dpkg-query -W -f='${Status}' cloudflare-warp 2>/dev/null | grep -q 'install ok installed'; then
            log_info "cloudflare-warp already installed (skipped)"
        else
            log_info "Installing cloudflare-warp..."
            if ! apt-get update >> "$LOG_FILE" 2>&1; then
                log_error "Failed to update package indices for cloudflare-warp"
                return 1
            fi
            if ! apt-get install -y cloudflare-warp >> "$LOG_FILE" 2>&1; then
                log_error "Failed to install cloudflare-warp"
                return 1
            fi
        fi
        log_info "ENABLE_WARPPLUS is true, cloudflare-warp will be installed"
    else
        log_info "ENABLE_WARPPLUS is false, cloudflare-warp installation skipped"
    fi

    log_success "All dependencies installed"
}

detect_server_addr() {
    if [[ -n "$SERVER_ADDR" ]]; then
        log_info "Using configured server address: $SERVER_ADDR"
        return 0
    fi

    while true; do
        if command -v curl &> /dev/null &&
            SERVER_ADDR=$(curl -fsS --max-time 15 https://api.ipify.org) &&
            [[ -n "$SERVER_ADDR" ]]; then
            log_info "Detected server address: $SERVER_ADDR"
            return 0
        fi

        log_warn "Could not automatically detect the server's public IP address."
        print_warn "Enter the public IP address or domain name clients will use to connect."
        if ! read -p "Server address (Enter to retry detection, or q to cancel installation): " -r SERVER_ADDR; then
            SERVER_ADDR=""
            return 1
        fi
        case "$SERVER_ADDR" in
            [Qq])
                SERVER_ADDR=""
                return 1
                ;;
            "")
                ;;
            *)
                log_info "Using manually entered server address: $SERVER_ADDR"
                return 0
                ;;
        esac
    done
}

create_directories() {
    log_info "Creating directory structure..."

    local dirs=(
        "/var/www/html"
        "/var/log/nginx"
        "/etc/nginx/ssl"
        "/etc/sing-box"
    )

    for dir in "${dirs[@]}"; do
        if [[ ! -d "$dir" ]]; then
            mkdir -p "$dir"
            log_info "Created directory: $dir"
        else
            log_info "Directory already exists: $dir"
        fi
    done

    log_success "Directory structure ready"
}

install_config_files() {
    log_info "Preparing configuration directories..."

    if [[ "${SELF_BACKEND}" == "true" ]]; then
        mkdir -p /etc/nginx/conf.d >> "$LOG_FILE" 2>&1 || return 1
        install_nginx_release || return 1
    fi

    if [[ ! -d /etc/sing-box ]]; then
        mkdir -p /etc/sing-box
        log_info "Created /etc/sing-box"
    fi
}

get_nginx_release_url() {
    if [[ -n "$NGINX_RELEASE_URL" ]]; then
        return 0
    fi

    log_error "NGINX_RELEASE_URL is not configured in the User configuration section"
    return 1
}

extract_release_archive() {
    local archive=$1
    local destination=$2

    case "$archive" in
        *.tar.gz|*.tgz) run_logged tar -xzf "$archive" -C "$destination" ;;
        *.tar.xz) run_logged tar -xJf "$archive" -C "$destination" ;;
        *.zip) run_logged unzip -q "$archive" -d "$destination" ;;
        *) return 1 ;;
    esac
}

install_nginx_release() {
    local archive="/tmp/singmanager-nginx-release"
    local extract_dir="/tmp/singmanager-nginx-release.$$"
    local package_dir

    if ! get_nginx_release_url; then
        log_error "Nginx Release URL is required when Nginx is enabled"
        return 1
    fi

    log_info "Downloading Nginx site package from GitHub Release..."
    rm -rf "$extract_dir" >> "$LOG_FILE" 2>&1
    mkdir -p "$extract_dir" >> "$LOG_FILE" 2>&1 || return 1

    case "$NGINX_RELEASE_URL" in
        *.tar.gz) archive+=".tar.gz" ;;
        *.tgz) archive+=".tgz" ;;
        *.tar.xz) archive+=".tar.xz" ;;
        *.zip) archive+=".zip" ;;
        *) archive+=".tar.gz" ;;
    esac

    if ! run_logged curl --fail --location --retry 3 --output "$archive" "$NGINX_RELEASE_URL"; then
        log_error "Failed to download Nginx Release package"
        return 1
    fi
    if ! extract_release_archive "$archive" "$extract_dir"; then
        log_error "Failed to extract Nginx Release package (tar.gz, tar.xz, or zip required)"
        return 1
    fi

    package_dir=$(find "$extract_dir" -type d -name nginx -print -quit 2>> "$LOG_FILE")
    [[ -n "$package_dir" ]] || package_dir="$extract_dir"
    if [[ ! -d "$package_dir/html" || ! -f "$package_dir/nginx.conf" ]]; then
        log_error "Release package must contain nginx/nginx.conf and nginx/html/"
        return 1
    fi

    if ! run_logged cp -a "$package_dir/html/." /var/www/html/; then
        log_error "Failed to install Nginx static files"
        return 1
    fi
    if ! run_logged cp -a "$package_dir/nginx.conf" /etc/nginx/nginx.conf; then
        log_error "Failed to install nginx.conf"
        return 1
    fi
    if [[ -d "$package_dir/conf.d" ]] && ! run_logged cp -a "$package_dir/conf.d/." /etc/nginx/conf.d/; then
        log_error "Failed to install Nginx site configuration"
        return 1
    fi

    rm -rf "$extract_dir" "$archive" >> "$LOG_FILE" 2>&1
    log_success "Nginx site files and configuration installed from Release"
}

validate_nginx_config() {
    NGINX_CONFIG_VALID="false"

    if [[ "${SELF_BACKEND}" != "true" ]]; then
        log_info "SELF_BACKEND is false, skipping nginx validation"
        return 0
    fi

    if ! command -v nginx &> /dev/null; then
        log_info "nginx not installed, skipping validation"
        return 0
    fi

    if [[ ! -s "$NGINX_CERT_FILE" || ! -s "$NGINX_KEY_FILE" ]]; then
        log_warn "Nginx TLS certificate or key is missing; request and install them manually before starting Nginx"
        log_warn "Expected certificate: $NGINX_CERT_FILE; private key: $NGINX_KEY_FILE"
        log_warn "Skipping Nginx validation and startup; sing-box installation will continue"
        return 0
    fi

    log_info "Validating nginx configuration..."

    if ! nginx -t >> "$LOG_FILE" 2>&1; then
        log_warn "Nginx configuration test failed; see $LOG_FILE. Skipping Nginx startup and continuing installation"
    else
        NGINX_CONFIG_VALID="true"
        log_success "nginx configuration OK"
    fi
}

setup_nginx_service() {
    if [[ "${SELF_BACKEND}" != "true" ]]; then
        log_info "SELF_BACKEND is false, skipping nginx service setup"
        return 0
    fi

    if ! command -v nginx &> /dev/null; then
        log_warn "nginx not installed, skipping service configuration"
        return 0
    fi

    if [[ "$NGINX_CONFIG_VALID" != "true" ]]; then
        log_warn "Nginx configuration is not ready; skipping Nginx service startup"
        return 0
    fi

    log_info "Configuring nginx service..."

    if run_logged systemctl enable nginx; then
        log_success "nginx enabled for autostart"
    else
        log_warn "Failed to enable Nginx autostart; see $LOG_FILE"
    fi

    if run_logged systemctl restart nginx; then
        log_success "nginx service configured and started"
    else
        log_warn "Failed to start Nginx; see $LOG_FILE. Continuing sing-box installation"
    fi
}

create_sing_box_user() {
    log_info "Creating sing-box user and directories..."

    if id "sing-box" &>/dev/null; then
        log_info "sing-box user already exists (skipped)"
    else
        log_info "Creating sing-box system user..."
        if useradd -r -s /bin/false -d /var/lib/sing-box -m -U sing-box >> "$LOG_FILE" 2>&1; then
            log_success "sing-box user created"
        else
            log_error "Failed to create sing-box user"
            return 1
        fi
    fi

    if [[ ! -d /var/lib/sing-box ]]; then
        mkdir -p /var/lib/sing-box
        log_info "Created /var/lib/sing-box"
    fi
    
    if [[ ! -d /etc/sing-box ]]; then
        mkdir -p /etc/sing-box
        log_info "Created /etc/sing-box"
    fi
    touch /var/log/sing-box.log
    chown sing-box:sing-box /var/log/sing-box.log
    chmod 644 /var/log/sing-box.log
    chown -R sing-box:sing-box /var/lib/sing-box
    chown -R sing-box:sing-box /etc/sing-box
    chmod 755 /var/lib/sing-box
    chmod 755 /etc/sing-box
    
    log_success "sing-box user and directories ready"
}

install_wrapplus() {
    if ! command -v warp-cli &> /dev/null; then
        log_error "warp-cli is not installed"
        return 1
    fi
    if warp-cli status 2>> "$LOG_FILE" | grep -qi "Connected"; then
        log_info "Cloudflare WARP is already connected"
        return 0
    fi
    if ! warp-cli registration show >> "$LOG_FILE" 2>&1; then
        if ! run_step "Cloudflare WARP registered" "Failed to register Cloudflare WARP" \
            warp-cli registration new --accept-tos; then
            return 1
        fi
    fi
    run_step "Cloudflare WARP proxy mode configured" "Failed to set Cloudflare WARP proxy mode" \
        warp-cli mode proxy || return 1
    run_step "Cloudflare WARP proxy port configured" "Failed to configure Cloudflare WARP proxy port" \
        warp-cli proxy port 40000 || return 1
    run_step "Cloudflare WARP connected" "Failed to connect Cloudflare WARP" \
        warp-cli connect || return 1
    run_logged warp-cli status
}

install_sing_box() {
    log_info "Preparing to install sing-box..."

    if command -v sing-box &> /dev/null; then
        local current_version=$(sing-box version 2>/dev/null | head -n1)
        log_warn "sing-box binary already installed (version: $current_version)"
        if [[ "$INSTALL_REPAIR_MODE" != "true" ]]; then
            read -p "Reinstall or update? (Y/n) " -n 1 -r
            echo
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                log_info "Skipping sing-box binary installation (already installed)"
                return 0
            fi
        else
            log_warn "Installation is incomplete or invalid; replacing the sing-box binary"
        fi
    fi

    local version="$SING_BOX_VERSION_DEFAULT"
    read -p "Enter sing-box version to install (default: ${version}): " -r version_input
    if [[ -n "$version_input" ]]; then
        version="$version_input"
    fi

    log_info "Installing sing-box (version: $version)..."

    if [[ "$version" == "latest" ]]; then
        if curl -fsSL "$SING_BOX_INSTALL_URL" | sh >> "$LOG_FILE" 2>&1; then
            log_info "sing-box installer executed"
        else
            log_error "sing-box installation failed"
            return 1
        fi
    else
        if curl -fsSL "$SING_BOX_INSTALL_URL" | sh -s -- --version "$version" >> "$LOG_FILE" 2>&1; then
            log_info "sing-box installer executed"
        else
            log_error "sing-box installation failed"
            return 1
        fi
    fi

    if command -v sing-box &> /dev/null; then
        local installed_version=$(sing-box version 2>/dev/null | head -n1)
        log_success "sing-box installed (version: $installed_version)"
    else
        log_error "sing-box executable not found after installation"
        return 1
    fi

}

generate_sg_config() {
    log_info "Generating Reality keypair..."
    if sing-box generate reality-keypair > /etc/sing-box/reality-keypair.txt 2>> "$LOG_FILE"; then
        log_success "Reality keypair generated"
    else
        log_error "Failed to generate Reality keypair"
        return 1
    fi

    log_info "Generating UUID..."
    if sing-box generate uuid > /etc/sing-box/uuid.txt 2>> "$LOG_FILE"; then
        log_success "UUID generated"
    else
        log_error "Failed to generate UUID"
        return 1
    fi
    chmod 600 /etc/sing-box/reality-keypair.txt /etc/sing-box/uuid.txt

    short_id=$(openssl rand -hex 8) || return 1
    printf '%s\n' "$short_id" > /etc/sing-box/short_id.txt
    private_key=$(cat /etc/sing-box/reality-keypair.txt | grep "PrivateKey" | awk -F': ' '{print $2}')
    public_key=$(cat /etc/sing-box/reality-keypair.txt | grep "PublicKey" | awk -F': ' '{print $2}')
    uuid=$(cat /etc/sing-box/uuid.txt)
    
    echo -e "${YELLOW}[Reality Configuration]${NC}"
    echo "Configure masquerade site for Reality handshake:"
    
    if [[ ${SELF_BACKEND} == "true" ]]; then
        fake_site="127.0.0.1"
        fake_site_port="18443"
        log_info "Fake site set to: $fake_site:$fake_site_port (self-hosted)"
    else
        fake_site="${FAKE_SITE:-cdnjs.cloudflare.com}"
        fake_site_port="${FAKE_SITE_PORT:-443}"
        log_info "SELF_BACKEND is false, using default fake site $fake_site:$fake_site_port"
    fi
    echo ""
    echo -e "${YELLOW}[VLESS Configuration]${NC}"
    echo "  • Server name [Inbound Address]: $SERVER_ADDR"
    echo "  • Reality short ID: $short_id"
    echo "  • Reality public key: $public_key"
    echo "  • UUID: $uuid"
    echo "  • Fake site: $fake_site:$fake_site_port"
    create_vless_json /etc/sing-box/vless.json || return 1
    rm -f /etc/sing-box/config.json >> "$LOG_FILE" 2>&1 || return 1
    ln -sf /etc/sing-box/vless.json /etc/sing-box/config.json || return 1
    log_info "VLESS configuration linked"
    
    log_success "sing-box configuration created with variables"
}

generate_qr_svg() {
    local content=$1
    local output_file=$2
    local temporary_file

    temporary_file=$(mktemp "${output_file}.XXXXXX") || {
        log_error "Failed to create a temporary QR file"
        return 1
    }
    if ! run_logged qrencode -t ANSIUTF8 -m 1 -l L -o "$temporary_file" "$content"; then
        rm -f "$temporary_file"
        log_error "Failed to generate QR code"
        return 1
    fi
    if ! run_logged mv -f "$temporary_file" "$output_file"; then
        rm -f "$temporary_file"
        log_error "Failed to save QR code to $output_file"
        return 1
    fi
}

generate_subscription() {
    log_info "Generating VLESS subscription link..."

    if [[ ! -f /etc/sing-box/config.json ]]; then
        log_error "Config file not found: /etc/sing-box/config.json"
        return 1
    fi

    local uuid flow port sni pbk sid server_addr vless_url
    uuid=$(jq -r '.inbounds[0].users[0].uuid' /etc/sing-box/config.json 2>/dev/null)
    flow=$(jq -r '.inbounds[0].users[0].flow' /etc/sing-box/config.json 2>/dev/null)
    port=$(jq -r '.inbounds[0].listen_port' /etc/sing-box/config.json 2>/dev/null)
    sni=$(jq -r '.inbounds[0].tls.server_name' /etc/sing-box/config.json 2>/dev/null)
    pbk=$(awk -F': ' '/^PublicKey: / {print $2}' /etc/sing-box/reality-keypair.txt)
    sid=$(jq -r '.inbounds[0].tls.reality.short_id[0]' /etc/sing-box/config.json 2>/dev/null)

    if [[ -z "$uuid" || -z "$port" || "$uuid" == "null" || "$port" == "null" ]]; then
        log_error "Failed to read VLESS parameters from config"
        return 1
    fi
    server_addr="${SERVER_ADDR:-localhost}"
    vless_url="vless://${uuid}@${server_addr}:${port}?encryption=none&flow=${flow}&type=none&security=reality&pbk=${pbk}&sid=${sid}&sni=${sni}&fp=chrome#VLESS"

    echo ""
    echo -e "${GREEN}════════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}VLESS Subscription Link${NC}"
    echo -e "${GREEN}════════════════════════════════════════════════════════${NC}"
    echo ""
    echo "Link: $vless_url"
    echo ""
    echo "Details:"
    echo "  • UUID: $uuid"
    echo "  • Server: $sni"
    echo "  • Port: $port"
    echo "  • Public key (pbk): $pbk"
    echo "  • Short ID (sid): $sid"
    echo "  • Flow: $flow"
    echo "  • Fake site (reality): $fake_site:$fake_site_port"
    echo ""

    printf '%s\n' "$vless_url" > /etc/sing-box/vless-subscription.txt || return 1
    generate_qr_svg "$vless_url" /etc/sing-box/vless-qr.svg || return 1
    log_success "VLESS subscription QR saved under /etc/sing-box"
    echo ""
}

setup_sing_box_service() {
    log_info "Configuring sing-box systemd service..."

    if [[ ! -d /etc/sing-box ]]; then
        log_warn "Directory /etc/sing-box not found, skipping service configuration"
        return 0
    fi

    local service_file="/etc/systemd/system/sing-box.service"
    local service_action

    log_info "Installing sing-box systemd service file..."
    if ! cat > "$service_file" << 'SYSTEMD_EOF'
[Unit]
Description=sing-box service
Documentation=https://sing-box.sagernet.org
After=network.target nss-lookup.target network-online.target

[Service]
User=sing-box
StateDirectory=sing-box
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
ExecStart=/usr/bin/sing-box -D /var/lib/sing-box -c /etc/sing-box/config.json run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
LimitNOFILE=infinity
Type=simple

[Install]
WantedBy=multi-user.target
SYSTEMD_EOF
    then
        log_error "Failed to write sing-box systemd service file"
        return 1
    fi
    if ! chmod 644 "$service_file" || ! run_logged systemctl daemon-reload; then
        log_error "Failed to install or reload sing-box systemd service"
        return 1
    fi
    log_success "sing-box systemd service file installed"

    if [[ -f /etc/sing-box/config.json ]]; then
        local log_file=$(jq -r '.log.output' /etc/sing-box/config.json 2>/dev/null || echo "")
        if [[ -n "$log_file" ]]; then
            touch "$log_file" 2>/dev/null || true
            chown sing-box:sing-box "$log_file" 2>/dev/null || true
            log_info "Log file configured: $log_file"
        fi
    fi
    
    chown root:root "$service_file" 2>/dev/null || true

    read -p "Enable and start sing-box service? (Y/n) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        log_info "Enabling sing-box autostart..."
        if systemctl enable sing-box >> "$LOG_FILE" 2>&1; then
            log_info "sing-box enabled for autostart"
        else
            log_warn "Failed to enable sing-box autostart"
        fi

        if [[ "$INSTALL_REPAIR_MODE" == "true" ]]; then
            log_info "Restarting sing-box service with repaired configuration..."
            service_action="restart"
        else
            log_info "Starting sing-box service..."
            service_action="start"
        fi
        if systemctl "$service_action" sing-box >> "$LOG_FILE" 2>&1; then
            log_info "sing-box $service_action command sent"
            sleep 2
            if systemctl is-active --quiet sing-box; then
                log_success "sing-box service is running"
            else
                log_error "sing-box service failed to run"
                log_info "Run 'journalctl -u sing-box -n 50' to view logs"
                return 1
            fi
        else
            log_error "Failed to $service_action sing-box service"
            log_info "Check configuration under /etc/sing-box/"
            return 1
        fi
    else
        log_info "sing-box service start skipped by user"
    fi
}

setup_permissions() {
    log_info "Setting file permissions..."

    if [[ "${SELF_BACKEND}" == "true" ]]; then
        chown -R www-data:www-data /var/www/html 2>/dev/null || true
        chmod -R 755 /var/www/html
        log_info "Web root permissions set"

        chown -R www-data:www-data /var/log/nginx 2>/dev/null || true
        chmod -R 755 /var/log/nginx
        log_info "Nginx logs permissions set"

        chmod 644 /etc/nginx/nginx.conf 2>/dev/null || true
        if [[ -f /etc/nginx/ssl/* ]]; then
            chmod 600 /etc/nginx/ssl/* 2>/dev/null || true
        fi
        log_info "Nginx config permissions set"
    else
        log_info "SELF_BACKEND is false, skipping nginx permissions"
    fi

    log_success "Permissions configured"
}

run_installation() {
    if installation_is_valid; then
        log_success "Installation check passed; existing installation is healthy"
        display_subscription_qr
        return 0
    fi
    INSTALL_REPAIR_MODE="true"
    log_warn "Installation is incomplete or invalid; running repair installation and overwriting managed configuration"

    confirm_startup_configuration
    print_header
    echo -e "${BLUE}Installation Wizard${NC}"
    echo ""
    
    echo -e "${YELLOW}⚠️  This script will install and configure services on your system.${NC}"
    echo ""
    echo "About to install:"
    echo "  • curl, wget, ca-certificates, openssl, jq, qrencode"
    if [[ "${SELF_BACKEND}" == "true" ]]; then
        echo "  • nginx (reverse proxy)"
    fi
    echo "  • sing-box (proxy server)"
    echo ""
    read -p "Do you want to continue with the installation? (Y/n): " -n 1 -r
    echo ""
    
    if [[ "$ENABLE_WARPPLUS" == "true" ]]; then
    WRAPPLUS_OUTBOUND='{
            "type": "socks",
            "tag": "warpplus-out",
            "server": "127.0.0.1",
            "server_port": 40000,
            "version": "5",
            "username": null,
            "password": null,
            "network": "tcp",
            "udp_over_tcp": true
        },'
    else
        # WRAPPLUS_OUTBOUND is empty when not enabled.
        # fake outbound
        WRAPPLUS_OUTBOUND='{
            "tag": "warpplus-out",
            "type": "direct"
        },'
    fi
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}Installation cancelled by user${NC}"
        return 0
    fi
    echo ""

    echo "Installation log: $LOG_FILE"
    echo ""

    check_system || return 1
    update_package_manager || return 1
    install_dependencies || return 1
    if ! detect_server_addr; then
        log_warn "Installation cancelled because no server address was provided"
        return 0
    fi
    rm -f /etc/sing-box/installation_complete.flag
    create_sing_box_user || return 1
    create_directories || return 1
    install_config_files || return 1
    if [[ "$ENABLE_WARPPLUS" == "true" ]]; then
        install_wrapplus || return 1
    fi
    install_sing_box || return 1
    generate_sg_config || return 1
    setup_sing_box_service || return 1
    validate_nginx_config || return 1
    setup_permissions || return 1
    setup_nginx_service || return 1
    generate_subscription || return 1
    install_singmanager_command || return 1
    touch /etc/sing-box/installation_complete.flag || {
        log_error "Failed to record installation completion"
        return 1
    }
    log_success "Installation completed successfully"

    display_subscription_qr
}

