                show_service_actions "nginx"
            fi
            ;;
        4)
            return 0
            ;;
        *)
            print_error "Invalid option"
            ;;
    esac
    
    pause_menu
    service_control
}

show_service_actions() {
    local service=$1
    
    echo -e "${CYAN}$service Service Actions${NC}"
    echo ""
    echo -e "  ${GREEN}1${NC}) Status"
    echo -e "  ${GREEN}2${NC}) Start"
    echo -e "  ${GREEN}3${NC}) Stop"
    echo -e "  ${GREEN}4${NC}) Restart"
    echo -e "  ${GREEN}5${NC}) Reload"
    echo -e "  ${GREEN}6${NC}) Enable autostart"
    echo -e "  ${GREEN}7${NC}) Disable autostart"
    echo -e "  ${GREEN}8${NC}) Back"
    echo ""
    
    read -p "Choose action (1-8): " action
    echo ""
    
    case $action in
        1)
            if systemctl is-active --quiet "$service" >> "$LOG_FILE" 2>&1; then
                print_success "$service is running"
            else
                print_warn "$service is not running"
            fi
            ;;
        2)
            print_info "Starting $service..."
            run_logged systemctl start "$service" && print_success "$service started" || print_error "Failed to start $service"
            ;;
        3)
            print_info "Stopping $service..."
            run_logged systemctl stop "$service" && print_success "$service stopped" || print_error "Failed to stop $service"
            ;;
        4)
            print_info "Restarting $service..."
            run_logged systemctl restart "$service" && print_success "$service restarted" || print_error "Failed to restart $service"
            ;;
        5)
            print_info "Reloading $service..."
            run_logged systemctl reload "$service" && print_success "$service reloaded" || print_error "Failed to reload $service"
            ;;
        6)
            print_info "Enabling $service autostart..."
            run_logged systemctl enable "$service" && print_success "$service autostart enabled" || print_error "Failed to enable autostart"
            ;;
        7)
            print_info "Disabling $service autostart..."
            run_logged systemctl disable "$service" && print_success "$service autostart disabled" || print_error "Failed to disable autostart"
            ;;
        8)
            return 0
            ;;
        *)
            print_error "Invalid action"
            ;;
    esac
}


main_loop() {
    local show_server_addr_notice="true"

    while true; do
        print_header
        if [[ "$show_server_addr_notice" == "true" ]] &&
            [[ -z "$SERVER_ADDR" ]] &&
            [[ ! -f /etc/sing-box/installation_complete.flag ]]; then
            print_warn "SERVER_ADDR is not set. Installation needs your public IP or domain for client subscriptions."
            print_info "The installer will try automatic detection; if that fails, you can enter the address manually."
            echo ""
        fi
        show_server_addr_notice="false"
        print_menu
        
        read -p "Choose an option (0-4): " choice
        echo ""
        
        case $choice in
            0)
                run_installation
                ;;
            1)
                show_sing_box_status
                ;;
            2)
                display_subscription_qr
                ;;
            3)
                service_control
                ;;
            4)
                print_info "Exiting..."
                echo ""
                exit 0
                ;;
            *)
                print_error "Invalid option. Please try again."
                sleep 1
                ;;
        esac
    done
}

# ============================================================================
# Script entry point
# ============================================================================
trap 'log_error "Operation failed at line $LINENO"; exit 1' ERR

check_root
main_loop
