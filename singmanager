#!/bin/bash

################################################################################
# singmanager - Unified installation and service management tool
# Purpose: Install and manage sing-box and nginx services
# Usage: sudo ./singmanager; after installation, run sudo singmanager
# Features:
#   - Idempotent installation and command setup in /usr/local/bin
#   - Interactive service management
#   - VLESS subscription QR code (256x256 px SVG)
#   - Complete logging to /tmp/install.log
################################################################################

set -o pipefail

# ============================================================================
# User configuration
# Edit the values in this section before running the script.  Configuration is
# intentionally kept in this script; /etc/singmanager.conf is not read.
# ============================================================================
# Set to true to install and use Nginx as the self-hosted backend. [true/false]
SELF_BACKEND="false"
NGINX_CERT_FILE="/etc/nginx/ssl/fullchain.cer"
NGINX_KEY_FILE="/etc/nginx/ssl/private.key"
NGINX_CONFIG_VALID="false"
# Required with SELF_BACKEND=true. The domain must be hosted on Cloudflare DNS.
SELF_DOMAIN=""
# Contact address used to register the Let's Encrypt ACME account.
ACME_EMAIL=""

# Required only when SELF_BACKEND=true.  It must point to a GitHub Release
# archive containing nginx/nginx.conf and nginx/html/.
NGINX_RELEASE_URL="https://github.com/Cerostep/sing-manager/releases/download/v1.0.0/nginx.tar.gz"
# This release supports only this sing-box version.
SING_BOX_VERSION="1.13.8"
SING_BOX_INSTALL_URL="https://sing-box.app/install.sh"

# WRAPPLUS_OUTBOUND is an optional outbound configuration snippet for sing-box.
# through the Cloudflare WARP+ service.  It is enabled by default.  Set to "false" to disable.
ENABLE_WARPPLUS="false"

LOG_FILE="/tmp/install.log"

# Preserve terminal stderr for controlled messages; command diagnostics go only
# to the installation log.
exec 3>&2
exec 2>>"$LOG_FILE"

# ============================================================================
# Color definitions
# ============================================================================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

# ============================================================================
# Logging helpers
# ============================================================================
log_info() {
    local msg="[INFO] $1"
    echo -e "${BLUE}${msg}${NC}"
    echo "$(date '+%Y-%m-%d %H:%M:%S') ${msg}" >> "$LOG_FILE"
}

log_success() {
    local msg="[✓] $1"
    echo -e "${GREEN}${msg}${NC}"
    echo "$(date '+%Y-%m-%d %H:%M:%S') ${msg}" >> "$LOG_FILE"
}

log_warn() {
    local msg="[WARN] $1"
    echo -e "${YELLOW}${msg}${NC}"
    echo "$(date '+%Y-%m-%d %H:%M:%S') ${msg}" >> "$LOG_FILE"
}

log_error() {
    local msg="[ERROR] $1"
    echo -e "${RED}${msg}${NC}" >&3
    echo "$(date '+%Y-%m-%d %H:%M:%S') ${msg}" >> "$LOG_FILE"
}

# Keep command diagnostics out of the interactive UI while retaining them for
# troubleshooting. Callers are responsible for presenting a concise result.
run_logged() {
    "$@" >> "$LOG_FILE" 2>&1
}

run_step() {
    local success_message=$1
    local failure_message=$2
    shift 2

    if run_logged "$@"; then
        log_success "$success_message"
        return 0
    fi

    log_error "$failure_message"
    return 1
}

# ============================================================================
# UI Helper functions
# ============================================================================
print_header() {
    clear
    echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}           🔧 Sing-box  Manager${NC}"
    echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
    echo ""
}

show_startup_configuration() {
    echo -e "${BLUE}Main script configuration (edit the User configuration section at the top of this script)${NC}"
    echo -e "  • SELF_BACKEND: $SELF_BACKEND"
    echo -e "  • NGINX_RELEASE_URL: ${NGINX_RELEASE_URL:-Not configured}"
    if [[ "$SELF_BACKEND" == "true" ]]; then
        echo -e "  • SELF_DOMAIN: ${SELF_DOMAIN:-Not configured}"
        echo -e "  • ACME_EMAIL: ${ACME_EMAIL:-Not configured}"
    fi
    echo -e "  • SING_BOX_VERSION: $SING_BOX_VERSION"
    echo -e "  • SING_BOX_INSTALL_URL: $SING_BOX_INSTALL_URL"
    if [[ "$SELF_BACKEND" == "true" ]]; then
        echo -e "  • Client connection address: $SELF_DOMAIN"
    else
        echo -e "  • Client connection address: auto-detect public IPv4"
    fi
    echo -e "  • ENABLE_WARPPLUS: ${ENABLE_WARPPLUS:-false}"
    echo ""
}

confirm_startup_configuration() {
    print_header
    show_startup_configuration
    read -p "Have you configured the variables above and want to continue with the current values? (Y/n): " -n 1 -r
    echo ""

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        print_info "Please update the User configuration section at the top of the script and run it again."
        exit 0
    fi
}

print_menu() {
    echo -e "${BLUE}📋 Main Menu${NC}"
    echo ""
    echo -e "  ${GREEN}0${NC}) Install or repair proxy server (sing-box) and dependencies"
    echo -e "  ${GREEN}1${NC}) View sing-box service status"
    echo -e "  ${GREEN}2${NC}) Display subscription QR codes"
    echo -e "  ${GREEN}3${NC}) Service control (start/stop/restart)"
    echo -e "  ${GREEN}4${NC}) Exit"
    echo ""
}

installation_is_valid() {
    local config_file="/etc/sing-box/config.json"
    local vless_config_file="/etc/sing-box/vless.json"
    local service_file="/etc/systemd/system/sing-box.service"
    local subscription_file="/etc/sing-box/vless-subscription.txt"
    local qr_file="/etc/sing-box/vless-qr.svg"
    local required_commands=(curl wget openssl jq qrencode unzip)
    local required_command subscription_uuid root_home expected_handshake_server subscription_addr
    local expected_server_name expected_handshake_port expected_outbound_type
    local expected_port="443"
    local installed_port installed_version

    if [[ ! -f /etc/sing-box/installation_complete.flag ]]; then
        log_warn "Installation completion marker is missing"
        return 1
    fi
    if [[ ! -x /usr/bin/sing-box ]] ||
        ! installed_version=$(/usr/bin/sing-box version 2>> "$LOG_FILE") ||
        [[ ! "$installed_version" =~ (^|[[:space:]])${SING_BOX_VERSION//./\\.}([[:space:]]|$) ]]; then
        log_warn "sing-box executable is missing, not working, or not version $SING_BOX_VERSION"
        return 1
    fi
    for required_command in "${required_commands[@]}"; do
        if ! command -v "$required_command" &> /dev/null; then
            log_warn "Required dependency $required_command is missing"
            return 1
        fi
    done
    if [[ ! -L "$config_file" ]] ||
        [[ "$(readlink -- "$config_file" 2>/dev/null)" != "$vless_config_file" ]]; then
        log_warn "sing-box config.json does not link to the managed VLESS configuration"
        return 1
    fi
    if [[ ! -s "$config_file" ]] || ! /usr/bin/sing-box check -c "$config_file" >> "$LOG_FILE" 2>&1; then
        log_warn "sing-box configuration is missing or invalid"
        return 1
    fi
    if [[ "$SELF_BACKEND" == "true" ]]; then
        expected_handshake_server="127.0.0.1"
        expected_handshake_port=18443
        expected_server_name="$SELF_DOMAIN"
    else
        expected_handshake_server="cdnjs.cloudflare.com"
        expected_handshake_port=443
        expected_server_name="cdnjs.cloudflare.com"
    fi
    if [[ "$ENABLE_WARPPLUS" == "true" ]]; then
        expected_outbound_type="socks"
    else
        expected_outbound_type="direct"
    fi
    if ! jq -e \
        --arg handshake_server "$expected_handshake_server" \
        --arg server_name "$expected_server_name" \
        --argjson handshake_port "$expected_handshake_port" \
        --arg outbound_type "$expected_outbound_type" \
        '.inbounds[0].type == "vless" and
         .inbounds[0].tls.server_name == $server_name and
         .inbounds[0].tls.reality.enabled == true and
         .inbounds[0].tls.reality.handshake.server == $handshake_server and
         .inbounds[0].tls.reality.handshake.server_port == $handshake_port and
         (.inbounds[0].users[0].uuid | type == "string" and length > 0) and
         any(.outbounds[]; .tag == "warpplus-out" and .type == $outbound_type)' \
        "$config_file" >/dev/null 2>&1; then
        log_warn "sing-box configuration does not match the selected deployment settings"
        return 1
    fi
    installed_port=$(jq -r '.inbounds[0].listen_port' "$config_file" 2>/dev/null)
    if [[ "$installed_port" != "$expected_port" ]]; then
        log_warn "sing-box is listening on unexpected port ${installed_port:-unknown}; expected $expected_port"
        return 1
    fi
    if [[ ! -s "$service_file" ]] ||
        ! grep -Fq 'User=sing-box' "$service_file" ||
        ! grep -Fq 'ExecStart=/usr/bin/sing-box -D /var/lib/sing-box -c /etc/sing-box/config.json run' "$service_file"; then
        log_warn "sing-box systemd service unit is missing or incorrect"
        return 1
    fi
    if [[ ! -s "$subscription_file" ]] || ! grep -q '^vless://' "$subscription_file"; then
        log_warn "VLESS subscription file is missing or invalid"
        return 1
    fi
    subscription_uuid=$(jq -r '.inbounds[0].users[0].uuid' "$config_file")
    if ! grep -Fq "vless://${subscription_uuid}@" "$subscription_file"; then
        log_warn "VLESS subscription does not match the installed configuration"
        return 1
    fi
    local subscription_line
    IFS= read -r subscription_line < "$subscription_file"
    if [[ ! "$subscription_line" =~ ^vless://[^@]+@([^:?#]+):${installed_port}\? ]]; then
        log_warn "VLESS subscription has an invalid server address or port"
        return 1
    fi
    subscription_addr="${BASH_REMATCH[1]}"
    if [[ "$SELF_BACKEND" == "true" ]]; then
        if [[ "$subscription_addr" != "$SELF_DOMAIN" ]]; then
            log_warn "VLESS subscription address does not match SELF_DOMAIN"
            return 1
        fi
    elif ! is_valid_client_server_address "$subscription_addr"; then
        log_warn "VLESS subscription does not contain a valid IPv4 address or domain"
        return 1
    fi
    if [[ ! -s "$qr_file" ]] ||
        ! grep -q '<svg width="256px" height="256px"' "$qr_file"; then
        log_warn "256x256 VLESS QR code is missing or invalid"
        return 1
    fi
    if [[ ! -x /usr/local/bin/singmanager ]] ||
        ! cmp -s "$(readlink -f -- "${BASH_SOURCE[0]}")" /usr/local/bin/singmanager; then
        log_warn "Installed /usr/local/bin/singmanager command is missing or outdated"
        return 1
    fi
    root_home=$(getent passwd root | cut -d: -f6)
    if [[ -z "$root_home" ]] || ! grep -Fq '/usr/local/bin' "$root_home/.bashrc"; then
        log_warn "Root user's .bashrc does not include /usr/local/bin"
        return 1
    fi
    if [[ "$SELF_BACKEND" == "true" ]] && ! command -v nginx &> /dev/null; then
        log_warn "Nginx is enabled but not installed"
        return 1
    fi
    if [[ "$SELF_BACKEND" == "true" ]] &&
        { [[ ! -s /etc/nginx/nginx.conf ]] || [[ ! -s /etc/nginx/conf.d/mask.conf ]]; }; then
        log_warn "Nginx is enabled but its main or site configuration is missing"
        return 1
    fi
    if [[ "$SELF_BACKEND" == "true" ]]; then
        local root_home acme_script
        root_home=$(getent passwd root | cut -d: -f6)
        acme_script="$root_home/.acme.sh/acme.sh"
        if [[ ! -x "$acme_script" ]] ||
            ! validate_nginx_certificate ||
            ! nginx -t >> "$LOG_FILE" 2>&1; then
            log_warn "Self-hosted Nginx, ACME, or domain certificate configuration is not ready"
            return 1
        fi
    fi

    return 0
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

legacy_print_error() {
    echo -e "${RED}✗ $1${NC}" >&2
}

# Override the legacy definition above so controlled errors remain visible.
print_error() {
    echo -e "${RED}Error: $1${NC}" >&3
}

print_info() {
    echo -e "${BLUE}ℹ $1${NC}"
}

print_warn() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

read() {
    if [[ "${1:-}" == "-p" ]]; then
        local prompt="$2"
        shift 2
        printf '%s' "$prompt" >&3
        builtin read "$@"
    else
        builtin read "$@"
    fi
}

pause_menu() {
    echo ""
    read -p "Press Enter to continue..."
}

install_singmanager_command() {
    local source_path target_path="/usr/local/bin/singmanager"
    local root_home bashrc
    local path_line='case ":$PATH:" in *:/usr/local/bin:*) ;; *) export PATH="/usr/local/bin:$PATH" ;; esac'

    source_path=$(readlink -f -- "${BASH_SOURCE[0]}") || {
        log_error "Failed to resolve the singmanager script path"
        return 1
    }
    if ! run_logged install -d -m 755 /usr/local/bin; then
        log_error "Failed to create /usr/local/bin"
        return 1
    fi
    if [[ "$source_path" != "$target_path" ]]; then
        if ! run_logged install -m 755 "$source_path" "$target_path"; then
            log_error "Failed to install singmanager to $target_path"
            return 1
        fi
    elif ! run_logged chmod 755 "$target_path"; then
        log_error "Failed to make $target_path executable"
        return 1
    fi

    root_home=$(getent passwd root | cut -d: -f6)
    if [[ -z "$root_home" ]]; then
        log_error "Failed to determine the root user's home directory"
        return 1
    fi
    bashrc="$root_home/.bashrc"
    if ! run_logged touch "$bashrc"; then
        log_error "Failed to create $bashrc"
        return 1
    fi
    if ! grep -Fqx "$path_line" "$bashrc"; then
        if ! printf '\n%s\n' "$path_line" >> "$bashrc"; then
            log_error "Failed to add /usr/local/bin to PATH in $bashrc"
            return 1
        fi
    fi

    log_success "Installed /usr/local/bin/singmanager and configured $bashrc"
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        print_error "This script requires root privileges"
        echo "Run: sudo $0"
        exit 1
    fi
}

# ============================================================================
# Installation functions
# ============================================================================
check_system() {
    : > "$LOG_FILE"
    log_info "Installation started (SELF_BACKEND=$SELF_BACKEND)"
    log_info "Checking system environment..."

    if [[ ! -f /etc/debian_version ]]; then
        log_error "This script supports only Debian/Ubuntu systems"
        exit 1
    fi

    log_success "System check passed"
}

update_package_manager() {
    log_info "Updating package indices..."
    if apt-get update >> "$LOG_FILE" 2>&1; then
        log_success "Package indices updated"
    else
        log_error "Failed to update package indices"
        exit 1
    fi
}

install_dependencies() {
    log_info "Installing dependencies..."

    local packages=(
        "curl"
        "wget"
        "ca-certificates"
        "openssl"
        "jq"
        "qrencode"
        "unzip"
    )

    if [[ "${SELF_BACKEND}" == "true" ]]; then
        packages+=("nginx")
        log_info "SELF_BACKEND is true, nginx will be installed"
    else
        log_info "SELF_BACKEND is false, nginx installation skipped"
    fi

    for package in "${packages[@]}"; do
        if dpkg -l | grep -qw "$package" 2>/dev/null; then
            log_info "$package already installed (skipped)"
        else
            log_info "Installing $package..."
            if apt-get install -y "$package" >> "$LOG_FILE" 2>&1; then
                log_success "$package installed successfully"
            else
                log_error "Failed to install $package"
                exit 1
            fi
        fi
    done

    
    if [[ "${ENABLE_WARPPLUS}" == "true" ]]; then
        local warp_packages=( "gpg" "lsb-release" )
        for wp_package in "${warp_packages[@]}"; do
            if dpkg -l | grep -qw "$wp_package" 2>/dev/null; then
                log_info "$wp_package already installed (skipped)"
            else
                log_info "Installing $wp_package..."
                if apt-get install -y "$wp_package" >> "$LOG_FILE" 2>&1; then
                    log_success "$wp_package installed successfully"
                else
                    log_error "Failed to install $wp_package"
                    exit 1
                fi
            fi
        done
        if curl -fsSL https://pkg.cloudflareclient.com/pubkey.gpg | gpg --yes --dearmor --output /usr/share/keyrings/cloudflare-warp-archive-keyring.gpg >> "$LOG_FILE" 2>&1; then
            echo "deb [signed-by=/usr/share/keyrings/cloudflare-warp-archive-keyring.gpg] https://pkg.cloudflareclient.com/ $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/cloudflare-client.list
            log_success "Warp GPG key downloaded and converted"
        else
            log_error "Failed to download Warp GPG key"
            exit 1
        fi
        if dpkg-query -W -f='${Status}' cloudflare-warp 2>/dev/null | grep -q 'install ok installed'; then
            log_info "cloudflare-warp already installed (skipped)"
        else
            log_info "Installing cloudflare-warp..."
            if ! apt-get update >> "$LOG_FILE" 2>&1; then
                log_error "Failed to update package indices for cloudflare-warp"
                return 1
            fi
            if ! apt-get install -y cloudflare-warp >> "$LOG_FILE" 2>&1; then
                log_error "Failed to install cloudflare-warp"
                return 1
            fi
        fi
        log_info "ENABLE_WARPPLUS is true, cloudflare-warp will be installed"
    else
        log_info "ENABLE_WARPPLUS is false, cloudflare-warp installation skipped"
    fi

    log_success "All dependencies installed"
}

resolve_client_server_addr() {
    local detection_url address

    if [[ "$SELF_BACKEND" == "true" ]]; then
        address="$SELF_DOMAIN"
        log_info "Using SELF_DOMAIN as the client connection address: $address" >&3
        printf '%s\n' "$address"
        return 0
    fi

    if command -v curl &> /dev/null; then
        for detection_url in https://api.ipify.org https://checkip.amazonaws.com; do
            if address=$(curl -4fsS --max-time 15 "$detection_url") &&
                is_valid_client_server_address "$address" &&
                [[ "$address" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
                log_info "Detected public IPv4 address using $detection_url: $address" >&3
                printf '%s\n' "$address"
                return 0
            fi
        done
    fi

    log_warn "Could not automatically detect a valid public IPv4 address." >&3
    print_warn "Enter the public IPv4 address or domain name clients will use to connect." >&3
    if ! read -p "Client connection address (or q to cancel installation): " -r address; then
        return 1
    fi
    if [[ "$address" == [Qq] ]]; then
        return 1
    fi
    if ! is_valid_client_server_address "$address"; then
        log_error "The client connection address must be a public IPv4 address or fully qualified domain name"
        return 1
    fi
    log_info "Using manually entered client connection address for this installation: $address" >&3
    printf '%s\n' "$address"
    return 0
}

is_valid_client_server_address() {
    local address=$1 octet
    local -a octets

    if [[ "$address" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        IFS='.' read -r -a octets <<< "$address"
        for octet in "${octets[@]}"; do
            (( 10#$octet <= 255 )) || return 1
        done
        return 0
    fi

    [[ "$address" =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]] &&
        (( ${#address} <= 253 ))
}

install_nginx_config_files() {
    if [[ "$SELF_BACKEND" != "true" ]]; then
        log_info "SELF_BACKEND is false, skipping Nginx configuration installation"
        return 0
    fi

    log_info "Preparing Nginx configuration directories..."
    local dirs=(
        "/var/www/html"
        "/var/log/nginx"
        "/etc/nginx/ssl"
        "/etc/nginx/conf.d"
    )
    local dir

    for dir in "${dirs[@]}"; do
        if ! mkdir -p "$dir"; then
            log_error "Failed to create Nginx directory: $dir"
            return 1
        fi
    done

    install_nginx_release || return 1
    obtain_nginx_certificate || return 1
    log_success "Nginx configuration files and certificate are ready"
}


validate_self_backend_settings() {
    if [[ "$SELF_BACKEND" != "true" ]]; then
        return 0
    fi

    if [[ ! "$SELF_DOMAIN" =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]] ||
        (( ${#SELF_DOMAIN} > 253 )); then
        log_error "SELF_DOMAIN must be a valid public DNS name when SELF_BACKEND=true"
        return 1
    fi
    if [[ ! "$ACME_EMAIL" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]]; then
        log_error "Set ACME_EMAIL to a valid contact email for the ACME account"
        return 1
    fi
}


install_acme_sh() {
    local root_home=$1
    local acme_script="$root_home/.acme.sh/acme.sh"
    local installer

    if [[ -x "$acme_script" ]]; then
        return 0
    fi

    installer=$(mktemp /tmp/singmanager-acme-install.XXXXXX.sh) || {
        log_error "Failed to create a temporary acme.sh installer file"
        return 1
    }
    log_info "Downloading the official acme.sh installer..."
    if ! run_logged curl --fail --location --retry 3 \
        --output "$installer" https://get.acme.sh; then
        rm -f "$installer"
        log_error "Failed to download the acme.sh installer"
        return 1
    fi
    if ! run_logged env HOME="$root_home" bash "$installer" "email=$ACME_EMAIL"; then
        rm -f "$installer"
        log_error "Failed to install acme.sh"
        return 1
    fi
    rm -f "$installer"
    if [[ ! -x "$acme_script" ]]; then
        log_error "acme.sh installer completed without creating $acme_script"
        return 1
    fi
}

obtain_nginx_certificate() {
    local root_home acme_home acme_script account_config cloudflare_token cert_public_key key_public_key
    local previous_umask

    root_home=$(getent passwd root | cut -d: -f6)
    if [[ -z "$root_home" ]]; then
        log_error "Failed to determine the root user's home directory"
        return 1
    fi
    acme_home="$root_home/.acme.sh"
    acme_script="$acme_home/acme.sh"
    account_config="$acme_home/account.conf"

    install_acme_sh "$root_home" || return 1
    mkdir -p /etc/nginx/ssl || {
        log_error "Failed to create the Nginx certificate directory"
        return 1
    }

    cloudflare_token="${CF_Token:-}"
    if [[ -z "$cloudflare_token" ]] &&
        ! grep -Eq '^(SAVED_)?CF_Token=' "$account_config" 2>/dev/null; then
        if [[ ! -t 0 ]]; then
            log_error "Cloudflare API Token is required; run the installer from an interactive terminal"
            return 1
        fi
        printf 'Enter a Cloudflare API Token with Zone DNS Edit and Zone Read permissions: ' >&3
        IFS= read -r -s cloudflare_token || {
            printf '\n' >&3
            log_error "Failed to read the Cloudflare API Token"
            return 1
        }
        printf '\n' >&3
    fi
    if [[ -n "$cloudflare_token" ]]; then
        export CF_Token="$cloudflare_token"
    fi

    chmod 700 "$acme_home" || {
        unset CF_Token
        log_error "Failed to secure the acme.sh configuration directory"
        return 1
    }
    if [[ -f "$account_config" ]] && ! chmod 600 "$account_config"; then
        unset CF_Token
        log_error "Failed to secure the acme.sh account configuration"
        return 1
    fi

    previous_umask=$(umask)
    umask 077
    log_info "Requesting or renewing the $SELF_DOMAIN certificate using acme.sh and Cloudflare DNS-01..."
    if ! run_logged env HOME="$root_home" "$acme_script" --set-default-ca --server letsencrypt ||
        ! run_logged env HOME="$root_home" "$acme_script" --issue \
            --server letsencrypt --dns dns_cf -d "$SELF_DOMAIN" ||
        ! run_logged env HOME="$root_home" "$acme_script" --install-cert -d "$SELF_DOMAIN" \
            --key-file "$NGINX_KEY_FILE" \
            --fullchain-file "$NGINX_CERT_FILE" \
            --reloadcmd "nginx -t && if systemctl is-active --quiet nginx; then systemctl reload nginx; else systemctl start nginx; fi"; then
        umask "$previous_umask"
        unset CF_Token
        log_error "acme.sh failed to issue or install the Nginx certificate; see $LOG_FILE"
        return 1
    fi
    umask "$previous_umask"
    unset CF_Token

    chmod 700 "$acme_home" || {
        log_error "Failed to secure the acme.sh configuration directory"
        return 1
    }
    if [[ -f "$account_config" ]] && ! chmod 600 "$account_config"; then
        log_error "Failed to secure the acme.sh account configuration"
        return 1
    fi
    chmod 600 "$NGINX_KEY_FILE" || {
        log_error "Failed to secure the Nginx private key"
        return 1
    }
    chmod 644 "$NGINX_CERT_FILE" || {
        log_error "Failed to set Nginx certificate permissions"
        return 1
    }

    validate_nginx_certificate || return 1
    if ! cert_public_key=$(openssl x509 -in "$NGINX_CERT_FILE" -pubkey -noout 2>> "$LOG_FILE" |
        openssl pkey -pubin -outform DER 2>> "$LOG_FILE" | sha256sum | awk '{print $1}'); then
        log_error "Failed to read the public key from the Nginx certificate"
        return 1
    fi
    if ! key_public_key=$(openssl pkey -in "$NGINX_KEY_FILE" -pubout -outform DER 2>> "$LOG_FILE" |
        sha256sum | awk '{print $1}'); then
        log_error "Failed to read the Nginx private key"
        return 1
    fi
    if [[ -z "$cert_public_key" || "$cert_public_key" != "$key_public_key" ]]; then
        log_error "The Nginx certificate and private key do not match"
        return 1
    fi
    log_success "ACME certificate installed and validated for $SELF_DOMAIN"
}

validate_nginx_certificate() {
    if [[ ! -s "$NGINX_CERT_FILE" || ! -s "$NGINX_KEY_FILE" ]]; then
        log_warn "Nginx TLS certificate or private key is missing"
        return 1
    fi
    if ! openssl x509 -in "$NGINX_CERT_FILE" -noout -checkhost "$SELF_DOMAIN" >> "$LOG_FILE" 2>&1; then
        log_warn "Nginx TLS certificate does not cover $SELF_DOMAIN"
        return 1
    fi
}

get_nginx_release_url() {
    if [[ -n "$NGINX_RELEASE_URL" ]]; then
        return 0
    fi

    log_error "NGINX_RELEASE_URL is not configured in the User configuration section"
    return 1
}

extract_release_archive() {
    local archive=$1
    local destination=$2

    case "$archive" in
        *.tar.gz|*.tgz) run_logged tar -xzf "$archive" -C "$destination" ;;
        *.tar.xz) run_logged tar -xJf "$archive" -C "$destination" ;;
        *.zip) run_logged unzip -q "$archive" -d "$destination" ;;
        *) return 1 ;;
    esac
}

install_nginx_release() {
    local archive="/tmp/singmanager-nginx-release"
    local extract_dir="/tmp/singmanager-nginx-release.$$"
    local package_dir

    if ! get_nginx_release_url; then
        log_error "Nginx Release URL is required when Nginx is enabled"
        return 1
    fi

    log_info "Downloading Nginx site package from GitHub Release..."
    rm -rf "$extract_dir" >> "$LOG_FILE" 2>&1
    mkdir -p "$extract_dir" >> "$LOG_FILE" 2>&1 || return 1

    case "$NGINX_RELEASE_URL" in
        *.tar.gz) archive+=".tar.gz" ;;
        *.tgz) archive+=".tgz" ;;
        *.tar.xz) archive+=".tar.xz" ;;
        *.zip) archive+=".zip" ;;
        *) archive+=".tar.gz" ;;
    esac

    if ! run_logged curl --fail --location --retry 3 --output "$archive" "$NGINX_RELEASE_URL"; then
        log_error "Failed to download Nginx Release package"
        return 1
    fi
    if ! extract_release_archive "$archive" "$extract_dir"; then
        log_error "Failed to extract Nginx Release package (tar.gz, tar.xz, or zip required)"
        return 1
    fi

    package_dir=$(find "$extract_dir" -type d -name nginx -print -quit 2>> "$LOG_FILE")
    [[ -n "$package_dir" ]] || package_dir="$extract_dir"
    if [[ ! -d "$package_dir/html" || ! -f "$package_dir/nginx.conf" ]]; then
        log_error "Release package must contain nginx/nginx.conf and nginx/html/"
        return 1
    fi

    if ! run_logged cp -a "$package_dir/html/." /var/www/html/; then
        log_error "Failed to install Nginx static files"
        return 1
    fi
    if ! run_logged cp -a "$package_dir/nginx.conf" /etc/nginx/nginx.conf; then
        log_error "Failed to install nginx.conf"
        return 1
    fi
    if [[ -d "$package_dir/conf.d" ]] && ! run_logged cp -a "$package_dir/conf.d/." /etc/nginx/conf.d/; then
        log_error "Failed to install Nginx site configuration"
        return 1
    fi

    rm -rf "$extract_dir" "$archive" >> "$LOG_FILE" 2>&1
    log_success "Nginx site files and configuration installed from Release"
}

validate_nginx_config() {
    NGINX_CONFIG_VALID="false"

    if [[ "${SELF_BACKEND}" != "true" ]]; then
        log_info "SELF_BACKEND is false, skipping nginx validation"
        return 0
    fi

    if ! command -v nginx &> /dev/null; then
        log_error "Nginx is required when SELF_BACKEND=true but is not installed"
        return 1
    fi

    validate_nginx_certificate || return 1

    log_info "Validating nginx configuration..."

    if ! nginx -t >> "$LOG_FILE" 2>&1; then
        log_error "Nginx configuration test failed; see $LOG_FILE"
        return 1
    else
        NGINX_CONFIG_VALID="true"
        log_success "nginx configuration OK"
    fi
}

setup_nginx_service() {
    if [[ "${SELF_BACKEND}" != "true" ]]; then
        log_info "SELF_BACKEND is false, skipping nginx service setup"
        return 0
    fi

    if ! command -v nginx &> /dev/null; then
        log_error "Nginx is required when SELF_BACKEND=true but is not installed"
        return 1
    fi

    if [[ "$NGINX_CONFIG_VALID" != "true" ]]; then
        log_error "Nginx configuration is not ready; refusing to start the service"
        return 1
    fi

    log_info "Configuring nginx service..."

    if run_logged systemctl enable nginx; then
        log_success "nginx enabled for autostart"
    else
        log_error "Failed to enable Nginx autostart; see $LOG_FILE"
        return 1
    fi

    if run_logged systemctl restart nginx; then
        log_success "nginx service configured and started"
    else
        log_error "Failed to start Nginx; see $LOG_FILE"
        return 1
    fi
}

create_sing_box_deps() {
    log_info "Creating sing-box user and directories..."

    if id "sing-box" &>/dev/null; then
        log_info "sing-box user already exists (skipped)"
    else
        log_info "Creating sing-box system user..."
        if useradd -r -s /bin/false -d /var/lib/sing-box -m -U sing-box >> "$LOG_FILE" 2>&1; then
            log_success "sing-box user created"
        else
            log_error "Failed to create sing-box user"
            return 1
        fi
    fi

    if [[ ! -d /var/lib/sing-box ]]; then
        mkdir -p /var/lib/sing-box
        log_info "Created /var/lib/sing-box"
    fi
    
    touch /var/log/sing-box.log
    chown sing-box:sing-box /var/log/sing-box.log

    chown -R sing-box:sing-box /var/lib/sing-box
    chown -R sing-box:sing-box /etc/sing-box

    chmod 644 /var/log/sing-box.log
    chmod 755 /var/lib/sing-box
    chmod 755 /etc/sing-box

