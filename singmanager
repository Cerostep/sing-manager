#!/bin/bash

################################################################################
# singmanager - Unified installation and service management tool
# Purpose: Install and manage sing-box and nginx services
# Usage: sudo ./singmanager or sudo bash singmanager
# Features:
#   - Idempotent installation
#   - Interactive service management
#   - Complete logging to /tmp/install.log
################################################################################

set -o pipefail

# ============================================================================
# User configuration
# Edit the values in this section before running the script.  Configuration is
# intentionally kept in this script; /etc/singmanager.conf is not read.
# ============================================================================
# Set to true to install and use Nginx as the self-hosted backend. [true/false]
SELF_BACKEND="false"
# Required only when SELF_BACKEND=true.  It must point to a GitHub Release
# archive containing nginx/nginx.conf and nginx/html/.
NGINX_RELEASE_URL="https://github.com/Cerostep/sing-manager/releases/download/v1.0.0/nginx.tar.gz"
# sing-box installer settings.
SING_BOX_VERSION_DEFAULT="1.13.8"
SING_BOX_INSTALL_URL="https://sing-box.app/install.sh"
# Cloudflare credentials are required only when issuing an AnyTLS certificate.
# Leave them empty to enter them securely during installation.
CF_Email=""
CF_Token=""

# WRAPPLUS_OUTBOUND is an optional outbound configuration snippet for sing-box.
# through the Cloudflare WARP+ service.  It is enabled by default.  Set to "false" to disable.
ENABLE_WARPPLUS="true"

# Runtime paths and defaults
PROTOCOL_TYPE="vless"
SERVER_ADDR=""
FAKE_SITE="cdnjs.cloudflare.com"
FAKE_SITE_PORT="443"
LOG_FILE="/tmp/install.log"
ACME_SH="/root/.acme.sh/acme.sh"
ACME_CERT_DIR="/etc/nginx/ssl"
ACME_CERT_FILE="$ACME_CERT_DIR/fullchain.cer"
ACME_KEY_FILE="$ACME_CERT_DIR/private.key"

# Preserve terminal stderr for controlled messages; command diagnostics go only
# to the installation log.
exec 3>&2
exec 2>>"$LOG_FILE"

# ============================================================================
# Color definitions
# ============================================================================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
NC='\033[0m'

# ============================================================================
# Logging helpers
# ============================================================================
log_info() {
    local msg="[INFO] $1"
    echo -e "${BLUE}${msg}${NC}"
    echo "$(date '+%Y-%m-%d %H:%M:%S') ${msg}" >> "$LOG_FILE"
}

log_success() {
    local msg="[✓] $1"
    echo -e "${GREEN}${msg}${NC}"
    echo "$(date '+%Y-%m-%d %H:%M:%S') ${msg}" >> "$LOG_FILE"
}

log_warn() {
    local msg="[WARN] $1"
    echo -e "${YELLOW}${msg}${NC}"
    echo "$(date '+%Y-%m-%d %H:%M:%S') ${msg}" >> "$LOG_FILE"
}

log_error() {
    local msg="[ERROR] $1"
    echo -e "${RED}${msg}${NC}" >&3
    echo "$(date '+%Y-%m-%d %H:%M:%S') ${msg}" >> "$LOG_FILE"
}

# Keep command diagnostics out of the interactive UI while retaining them for
# troubleshooting. Callers are responsible for presenting a concise result.
run_logged() {
    "$@" >> "$LOG_FILE" 2>&1
}

run_step() {
    local success_message=$1
    local failure_message=$2
    shift 2

    if run_logged "$@"; then
        log_success "$success_message"
        return 0
    fi

    log_error "$failure_message"
    return 1
}

# ============================================================================
# UI Helper functions
# ============================================================================
print_header() {
    clear
    echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
    echo -e "${CYAN}           🔧 Sing-box  Manager${NC}"
    echo -e "${CYAN}════════════════════════════════════════════════════════${NC}"
    echo ""
}

mask_secret() {
    local secret=$1

    if [[ -z "$secret" ]]; then
        echo "Not configured"
    else
        echo "Configured (hidden)"
    fi
}

show_startup_configuration() {
    echo -e "${BLUE}Main script configuration (edit the User configuration section at the top of this script)${NC}"
    echo -e "${RED}  • SELF_BACKEND: $SELF_BACKEND"
    echo -e "${GREEN}  • NGINX_RELEASE_URL: ${NGINX_RELEASE_URL:-Not configured}"
    echo -e "${RED}  • SING_BOX_VERSION_DEFAULT: $SING_BOX_VERSION_DEFAULT"
    echo -e "${GREEN}  • SING_BOX_INSTALL_URL: $SING_BOX_INSTALL_URL"
    echo -e "${RED}  • FAKE_SITE: $FAKE_SITE"
    echo -e "${GREEN}  • FAKE_SITE_PORT: $FAKE_SITE_PORT"
    echo -e "${RED}  • SERVER_ADDR: ${SERVER_ADDR:-Not configured}"
    echo -e "${GREEN}  • ENABLE_WARPPLUS: ${ENABLE_WARPPLUS:-false}"
    echo -e "${RED}  • CF_Email: ${CF_Email:-Not configured}"
    echo -e "${GREEN}  • CF_Token: $(mask_secret "$CF_Token")"
    echo ""
}

confirm_startup_configuration() {
    print_header
    show_startup_configuration
    read -p "Have you configured the variables above and want to continue with the current values? (Y/n): " -n 1 -r
    echo ""

    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        print_info "Please update the User configuration section at the top of the script and run it again."
        exit 0
    fi
}

print_menu() {
    echo -e "${BLUE}📋 Main Menu${NC}"
    echo ""
    if [[ -f /etc/sing-box/installation_complete.flag ]]; then
        echo -e "${YELLOW}Installation already completed. To reinstall, remove /etc/sing-box/installation_complete.flag and run the script again.${NC}"
    else
        echo -e "  ${GREEN}0${NC}) Install proxy server (sing-box) and dependencies"
    fi
    echo -e "  ${GREEN}1${NC}) View sing-box service status"
    echo -e "  ${GREEN}2${NC}) Display subscription QR codes"
    echo -e "  ${GREEN}3${NC}) Service control (start/stop/restart)"
    echo -e "  ${GREEN}4${NC}) Exit"
    echo ""
}

print_success() {
    echo -e "${GREEN}✓ $1${NC}"
}

legacy_print_error() {
    echo -e "${RED}✗ $1${NC}" >&2
}

# Override the legacy definition above so controlled errors remain visible.
print_error() {
    echo -e "${RED}Error: $1${NC}" >&3
}

print_info() {
    echo -e "${BLUE}ℹ $1${NC}"
}

print_warn() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

read() {
    if [[ "${1:-}" == "-p" ]]; then
        local prompt="$2"
        shift 2
        printf '%s' "$prompt" >&3
        builtin read "$@"
    else
        builtin read "$@"
    fi
}

pause_menu() {
    echo ""
    read -p "Press Enter to continue..."
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        print_error "This script requires root privileges"
        echo "Run: sudo $0"
        exit 1
    fi
}

# ============================================================================
# Installation functions
# ============================================================================
check_system() {
    : > "$LOG_FILE"
    log_info "Installation started (SELF_BACKEND=$SELF_BACKEND)"
    log_info "Checking system environment..."

    if [[ ! -f /etc/debian_version ]]; then
        log_error "This script supports only Debian/Ubuntu systems"
        exit 1
    fi

    log_success "System check passed"
}

update_package_manager() {
    log_info "Updating package indices..."
    if apt-get update >> "$LOG_FILE" 2>&1; then
        log_success "Package indices updated"
    else
        log_error "Failed to update package indices"
        exit 1
    fi
}

install_dependencies() {
    log_info "Installing dependencies..."

    local packages=(
        "curl"
        "wget"
        "ca-certificates"
        "openssl"
        "jq"
        "qrencode"
        "unzip"
    )

    if [[ "${SELF_BACKEND}" == "true" ]]; then
        packages+=("nginx")
        log_info "SELF_BACKEND is true, nginx will be installed"
    else
        log_info "SELF_BACKEND is false, nginx installation skipped"
    fi

    for package in "${packages[@]}"; do
        if dpkg -l | grep -qw "$package" 2>/dev/null; then
            log_info "$package already installed (skipped)"
        else
            log_info "Installing $package..."
            if apt-get install -y "$package" >> "$LOG_FILE" 2>&1; then
                log_success "$package installed successfully"
            else
                log_error "Failed to install $package"
                exit 1
            fi
        fi
    done

    
    if [[ "${ENABLE_WARPPLUS}" == "true" ]]; then
        local warp_packages=( "gpg" "lsb-release" )
        for wp_package in "${warp_packages[@]}"; do
            if dpkg -l | grep -qw "$wp_package" 2>/dev/null; then
                log_info "$wp_package already installed (skipped)"
            else
                log_info "Installing $wp_package..."
                if apt-get install -y "$wp_package" >> "$LOG_FILE" 2>&1; then
                    log_success "$wp_package installed successfully"
                else
                    log_error "Failed to install $wp_package"
                    exit 1
                fi
            fi
        done
        if curl -fsSL https://pkg.cloudflareclient.com/pubkey.gpg | gpg --yes --dearmor --output /usr/share/keyrings/cloudflare-warp-archive-keyring.gpg >> "$LOG_FILE" 2>&1; then
            echo "deb [signed-by=/usr/share/keyrings/cloudflare-warp-archive-keyring.gpg] https://pkg.cloudflareclient.com/ $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/cloudflare-client.list
            log_success "Warp GPG key downloaded and converted"
        else
            log_error "Failed to download Warp GPG key"
            exit 1
        fi
        if dpkg -l |grep qw "cloudflare-warp" 2>/dev/null; then
            log_info "cloudflare-warp already installed (skipped)"
        else
            log_info "Installing cloudflare-warp..."
            apt-get -y update cloudflare-warp >> "$LOG_FILE" 2>&1
            if $? -ne 0; then
                log_error "Failed to update package indices for cloudflare-warp"
                exit 1
            fi
        fi
        log_info "ENABLE_WARPPLUS is true, cloudflare-warp will be installed"
    else
        log_info "ENABLE_WARPPLUS is false, cloudflare-warp installation skipped"
    fi

    log_success "All dependencies installed"
}

create_directories() {
    log_info "Creating directory structure..."

    local dirs=(
        "/var/www/html"
        "/var/log/nginx"
        "/etc/nginx/ssl"
        "/etc/sing-box"
    )

    for dir in "${dirs[@]}"; do
        if [[ ! -d "$dir" ]]; then
            mkdir -p "$dir"
            log_info "Created directory: $dir"
        else
            log_info "Directory already exists: $dir"
        fi
    done

    log_success "Directory structure ready"
}

install_config_files() {
    log_info "Preparing configuration directories..."

    if [[ "${SELF_BACKEND}" == "true" ]]; then
        mkdir -p /etc/nginx/conf.d >> "$LOG_FILE" 2>&1 || return 1
        install_nginx_release || return 1
    fi

    if [[ ! -d /etc/sing-box ]]; then
        mkdir -p /etc/sing-box
        log_info "Created /etc/sing-box"
    fi
}

get_nginx_release_url() {
    if [[ -n "$NGINX_RELEASE_URL" ]]; then
        return 0
    fi

    log_error "NGINX_RELEASE_URL is not configured in the User configuration section"
    return 1
}

extract_release_archive() {
    local archive=$1
    local destination=$2

    case "$archive" in
        *.tar.gz|*.tgz) run_logged tar -xzf "$archive" -C "$destination" ;;
        *.tar.xz) run_logged tar -xJf "$archive" -C "$destination" ;;
        *.zip) run_logged unzip -q "$archive" -d "$destination" ;;
        *) return 1 ;;
    esac
}

install_nginx_release() {
    local archive="/tmp/singmanager-nginx-release"
    local extract_dir="/tmp/singmanager-nginx-release.$$"
    local package_dir

    if ! get_nginx_release_url; then
        log_error "Nginx Release URL is required when Nginx is enabled"
        return 1
    fi

    log_info "Downloading Nginx site package from GitHub Release..."
    rm -rf "$extract_dir" >> "$LOG_FILE" 2>&1
    mkdir -p "$extract_dir" >> "$LOG_FILE" 2>&1 || return 1

    case "$NGINX_RELEASE_URL" in
        *.tar.gz) archive+=".tar.gz" ;;
        *.tgz) archive+=".tgz" ;;
        *.tar.xz) archive+=".tar.xz" ;;
        *.zip) archive+=".zip" ;;
        *) archive+=".tar.gz" ;;
    esac

    if ! run_logged curl --fail --location --retry 3 --output "$archive" "$NGINX_RELEASE_URL"; then
        log_error "Failed to download Nginx Release package"
        return 1
    fi
    if ! extract_release_archive "$archive" "$extract_dir"; then
        log_error "Failed to extract Nginx Release package (tar.gz, tar.xz, or zip required)"
        return 1
    fi

    package_dir=$(find "$extract_dir" -type d -name nginx -print -quit 2>> "$LOG_FILE")
    [[ -n "$package_dir" ]] || package_dir="$extract_dir"
    if [[ ! -d "$package_dir/html" || ! -f "$package_dir/nginx.conf" ]]; then
        log_error "Release package must contain nginx/nginx.conf and nginx/html/"
        return 1
    fi

    if ! run_logged cp -a "$package_dir/html/." /var/www/html/; then
        log_error "Failed to install Nginx static files"
        return 1
    fi
    if ! run_logged cp -a "$package_dir/nginx.conf" /etc/nginx/nginx.conf; then
        log_error "Failed to install nginx.conf"
        return 1
    fi
    if [[ -d "$package_dir/conf.d" ]] && ! run_logged cp -a "$package_dir/conf.d/." /etc/nginx/conf.d/; then
        log_error "Failed to install Nginx site configuration"
        return 1
    fi

    rm -rf "$extract_dir" "$archive" >> "$LOG_FILE" 2>&1
    log_success "Nginx site files and configuration installed from Release"
}

setup_ssl_certificates() {
    if [[ "${SELF_BACKEND}" != "true" ]]; then
        log_info "SELF_BACKEND is false, skipping SSL certificates setup"
        return 0
    fi

    log_info "SSL certificates setup ready"
}

require_cloudflare_credentials() {
    if [[ -z "${CF_Email:-}" ]]; then
        read -r -p "Cloudflare account email (CF_Email): " CF_Email
    fi
    if [[ -z "${CF_Token:-}" ]]; then
        read -r -s -p "Cloudflare API token (CF_Token): " CF_Token
        echo
    fi

    if [[ -z "$CF_Email" || -z "$CF_Token" ]]; then
        log_error "Nginx certificate issuance requires CF_Email and CF_Token"
        return 1
    fi

    export CF_Email CF_Token
}

install_acme_sh() {
    if [[ -x "$ACME_SH" ]]; then
        return 0
    fi

    log_info "Installing acme.sh..."
    if ! curl -fsSL https://get.acme.sh | sh -s email="$CF_Email" >> "$LOG_FILE"; then
        log_error "Failed to install acme.sh"
        return 1
    fi
    [[ -x "$ACME_SH" ]]
}

issue_nginx_certificate() {
    local domain=$1

    if [[ "$domain" != *.* ]]; then
        log_error "Nginx certificate issuance requires a valid public domain name"
        return 1
    fi
    require_cloudflare_credentials || return 1
    install_acme_sh || return 1

    log_info "Requesting Nginx certificate through Cloudflare DNS validation..."
    if ! run_logged "$ACME_SH" --issue --dns dns_cf -d "$domain" -d "*.$domain"; then
        log_error "Cloudflare DNS certificate issuance failed"
        return 1
    fi

    if ! run_logged mkdir -p "$ACME_CERT_DIR"; then
        log_error "Failed to create the certificate directory"
        return 1
    fi
    if ! run_logged "$ACME_SH" --install-cert -d "$domain" --key-file "$ACME_KEY_FILE" --fullchain-file "$ACME_CERT_FILE" --reloadcmd "chown root:root $ACME_CERT_FILE $ACME_KEY_FILE && chmod 600 $ACME_KEY_FILE && (systemctl reload nginx >/dev/null 2>&1 || true)"; then
        log_error "Failed to install the Nginx certificate"
        return 1
    fi
    if ! run_logged chown -R root:root "$ACME_CERT_DIR"; then
        log_error "Failed to set certificate ownership"
        return 1
    fi
    if ! run_logged chmod 700 "$ACME_CERT_DIR"; then
        log_error "Failed to secure the certificate directory"
        return 1
    fi
    if ! run_logged chmod 600 "$ACME_KEY_FILE"; then
        log_error "Failed to secure the certificate key"
        return 1
    fi

    log_success "Nginx certificate installed at $ACME_CERT_DIR"
}

validate_nginx_config() {
    if [[ "${SELF_BACKEND}" != "true" ]]; then
        log_info "SELF_BACKEND is false, skipping nginx validation"
        return 0
    fi

    if ! command -v nginx &> /dev/null; then
        log_info "nginx not installed, skipping validation"
        return 0
    fi

    log_info "Validating nginx configuration..."

    if ! nginx -t >> "$LOG_FILE" 2>&1; then
        log_error "nginx configuration test failed. Please check configuration files"
    else
        log_success "nginx configuration OK"
    fi
}

setup_nginx_service() {
    if [[ "${SELF_BACKEND}" != "true" ]]; then
        log_info "SELF_BACKEND is false, skipping nginx service setup"
        return 0
    fi

    if ! command -v nginx &> /dev/null; then
        log_warn "nginx not installed, skipping service configuration"
        return 0
    fi

    log_info "Configuring nginx service..."

    if ! run_step "nginx enabled for autostart" "Failed to enable nginx autostart" systemctl enable nginx; then
        log_warn "Nginx can still be started manually"
    fi

    if ! run_step "nginx service configured and started" "Failed to start nginx" systemctl restart nginx; then
        return 1
    fi
}

create_sing_box_user() {
    log_info "Creating sing-box user and directories..."

    if id "sing-box" &>/dev/null; then
        log_info "sing-box user already exists (skipped)"
    else
        log_info "Creating sing-box system user..."
        if useradd -r -s /bin/false -d /var/lib/sing-box -m -U sing-box >> "$LOG_FILE" 2>&1; then
            log_success "sing-box user created"
        else
            log_error "Failed to create sing-box user"
            return 1
        fi
    fi

    if [[ ! -d /var/lib/sing-box ]]; then
        mkdir -p /var/lib/sing-box
        log_info "Created /var/lib/sing-box"
    fi
    
    if [[ ! -d /etc/sing-box ]]; then
        mkdir -p /etc/sing-box
        log_info "Created /etc/sing-box"
    fi

    chown -R sing-box:sing-box /var/lib/sing-box
    chown -R sing-box:sing-box /etc/sing-box
    chmod 755 /var/lib/sing-box
    chmod 755 /etc/sing-box
    
    log_success "sing-box user and directories ready"
}

install_wrapplus() {
    # Initial connection
    # To connect for the very first time:

    # Register the client warp-cli registration new.
    # Connect warp-cli connect.
    # Run curl https://www.cloudflare.com/cdn-cgi/trace and verify that warp=on.
    # Switch modes
    # You can use warp-cli mode --help to get a list of modes to switch between. For example:

    # DNS only mode via DoH: warp-cli mode doh
    # WARP with DoH: warp-cli mode warp+doh
    # Switch tunnel protocol
    # You can switch the protocol that WARP uses to route traffic from the device to Cloudflare.

    # WireGuard: warp-cli tunnel protocol set WireGuard
    # MASQUE: (default) warp-cli tunnel protocol set MASQUE
    warp-cli registration new  --accept-tos
    warp-cli mode proxy
    warp-cli proxy port 40000
    warp-cli connect
    warp-cli status
}

install_sing_box() {
    log_info "Preparing to install sing-box..."

    echo ""
    echo "Select protocol type:"
    echo "  1) AnyTLS"
    echo "  2) VLESS"
    read -p "Choose protocol (1 or 2, default: 1): " -r protocol_choice
    protocol_choice=${protocol_choice:-1}

    if [[ "$protocol_choice" == "2" ]]; then
        protocol_type="vless"
        log_info "Selected protocol: VLESS"
        echo -e "${GREEN}Configuring for VLESS${NC}"
    else
        protocol_type="anytls"
        log_info "Selected protocol: AnyTLS"
        echo -e "${GREEN}Configuring for AnyTLS${NC}"
    fi
    echo ""

    if command -v sing-box &> /dev/null; then
        local current_version=$(sing-box version 2>/dev/null | head -n1)
        log_warn "sing-box binary already installed (version: $current_version)"
        read -p "Reinstall or update? (Y/n) " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            log_info "Skipping sing-box binnary installation (already installed)"
            log_info "Continue to generate the sing-box config.json"
            generate_sg_config
            return 0
        fi
    fi

    local version="$SING_BOX_VERSION_DEFAULT"
    read -p "Enter sing-box version to install (default: ${version}): " -r version_input
    if [[ -n "$version_input" ]]; then
        version="$version_input"
    fi

    log_info "Installing sing-box (version: $version)..."

    if [[ "$version" == "latest" ]]; then
        if curl -fsSL "$SING_BOX_INSTALL_URL" | sh >> "$LOG_FILE" 2>&1; then
            log_info "sing-box installer executed"
        else
            log_error "sing-box installation failed"
            return 1
        fi
    else
        if curl -fsSL "$SING_BOX_INSTALL_URL" | sh -s -- --version "$version" >> "$LOG_FILE" 2>&1; then
            log_info "sing-box installer executed"
        else
            log_error "sing-box installation failed"
            return 1
        fi
    fi

    if command -v sing-box &> /dev/null; then
        local installed_version=$(sing-box version 2>/dev/null | head -n1)
        log_success "sing-box installed (version: $installed_version)"
    else
        log_error "sing-box executable not found after installation"
        return 1
    fi

    setup_sing_box_service
}

generate_sg_config() {
    log_info "Generating Reality keypair..."
    if sing-box generate reality-keypair > /etc/sing-box/reality-keypair.txt 2>> "$LOG_FILE"; then
        log_success "Reality keypair generated"
    else
        log_error "Failed to generate Reality keypair"
        return 1
    fi

    log_info "Generating UUID..."
    if sing-box generate uuid > /etc/sing-box/uuid.txt 2>> "$LOG_FILE"; then
        log_success "UUID generated"
    else
        log_error "Failed to generate UUID"
        return 1
    fi
    
    if [[ "$protocol_type" == "anytls" ]]; then
        # AnyTLS Password. 
        log_info "Generating Password..."
        if sing-box generate uuid > /etc/sing-box/password.txt 2>> "$LOG_FILE"; then
            chmod 600 /etc/sing-box/password.txt
            anytls_password=$(cat /etc/sing-box/password.txt)
            log_success "Password generated"
        else
            log_error "Failed to generate password"
            return 1
        fi
    fi

    chmod 600 /etc/sing-box/reality-keypair.txt /etc/sing-box/uuid.txt

    short_id=$(openssl rand -hex 8)
    echo $short_id > /etc/sing-box/short_id.txt
    private_key=$(cat /etc/sing-box/reality-keypair.txt | grep "PrivateKey" | awk -F': ' '{print $2}')
    public_key=$(cat /etc/sing-box/reality-keypair.txt | grep "PublicKey" | awk -F': ' '{print $2}')
    uuid=$(cat /etc/sing-box/uuid.txt)
    
    echo -e "${YELLOW}[Reality Configuration]${NC}"
    echo "Configure masquerade site for Reality handshake:"
    
    if [[ ${SELF_BACKEND} == "true" ]]; then
        fake_site="${SERVER_ADDR}"
        fake_site_port="443"
        log_info "Fake site set to: $fake_site:$fake_site_port (self-hosted)"
    else
        fake_site="${FAKE_SITE:-cdnjs.cloudflare.com}"
        fake_site_port="${FAKE_SITE_PORT:-443}"
        log_info "SELF_BACKEND is false, using default fake site $fake_site:$fake_site_port"
    fi
    echo ""

    rm -f /etc/sing-box/config.json >> "$LOG_FILE" 2>&1
    
    if [[ "$protocol_type" == "vless" ]]; then
        echo -e "${YELLOW}[VLESS Configuration]${NC}"
        echo "  • Server name [Inbound Address]: $SERVER_ADDR"
        echo "  • Reality short ID: $short_id"
        echo "  • Reality public key: $public_key"
        echo "  • UUID: $uuid"
        echo "  • Fake site: $fake_site:$fake_site_port"
        create_vless_json /etc/sing-box/vless.json
        ln -sf /etc/sing-box/vless.json /etc/sing-box/config.json
        log_info "VLESS configuration linked"
    else
        echo -e "${YELLOW}[AnyTLS Configuration]${NC}"
        echo "  • Username: admin007"
        echo "  • Password: $anytls_password"
        echo "  • Server name [Inbound Address]: $SERVER_ADDR"
        echo "  • Reality short ID: $short_id"
        echo "  • Reality public key: $public_key"
        echo "  • Fake site: $fake_site:$fake_site_port"
        create_anytls_json /etc/sing-box/anyTLS.json
        ln -sf /etc/sing-box/anyTLS.json /etc/sing-box/config.json
        log_info "AnyTLS configuration linked"
    fi
    
    log_success "sing-box configuration created with variables"
}

generate_subscription() {
    log_info "Generating subscription link..."

    if [[ ! -f /etc/sing-box/config.json ]]; then
        log_error "Config file not found: /etc/sing-box/config.json"
        return 1
    fi
    
    if [[ "$protocol_type" == "vless" ]]; then
        local uuid=$(jq -r '.inbounds[0].users[0].uuid' /etc/sing-box/config.json 2>/dev/null)
        local flow=$(jq -r '.inbounds[0].users[0].flow' /etc/sing-box/config.json 2>/dev/null)
        local port=$(jq -r '.inbounds[0].listen_port' /etc/sing-box/config.json 2>/dev/null)
        local sni=$(jq -r '.inbounds[0].tls.server_name' /etc/sing-box/config.json 2>/dev/null)
        local pbk=$(cat /etc/sing-box/reality-keypair.txt | grep "PublicKey" | awk -F': ' '{print $2}')
        local sid=$(jq -r '.inbounds[0].tls.reality.short_id[0]' /etc/sing-box/config.json 2>/dev/null)

        if [[ -z "$uuid" || -z "$port" ]]; then
            log_error "Failed to read VLESS parameters from config"
            return 1
        fi
        local server_addr="${SERVER_ADDR:-localhost}"
        local vless_url="vless://${uuid}@${server_addr}:${port}?encryption=none&flow=${flow}&type=none&security=reality&pbk=${pbk}&sid=${sid}&sni=${sni}&fp=chrome#VLESS"

        echo ""
        echo -e "${GREEN}════════════════════════════════════════════════════════${NC}"
        echo -e "${GREEN}VLESS Subscription Link${NC}"
        echo -e "${GREEN}════════════════════════════════════════════════════════${NC}"
        echo ""
        echo "Link: $vless_url"
        echo ""
        echo "Details:"
        echo "  • UUID: $uuid"
        echo "  • Server: $sni"
        echo "  • Port: $port"
        echo "  • Public key (pbk): $pbk"
        echo "  • Short ID (sid): $sid"
        echo "  • Flow: $flow"
        echo "  • Fake site (reality): $fake_site:$fake_site_port"
        echo ""

        if command -v qrencode &> /dev/null; then
            echo "$vless_url" | qrencode -t ANSI256
        fi

        echo "$vless_url" > /etc/sing-box/vless-subscription.txt
        log_success "VLESS subscription generated and saved to /etc/sing-box/vless-subscription.txt"

    else
        #　AnyTLS subscription generation
        local username=$(jq -r '.inbounds[0].users[0].name' /etc/sing-box/config.json 2>/dev/null)
        local password=$(jq -r '.inbounds[0].users[0].password' /etc/sing-box/config.json 2>/dev/null)
        local port=$(jq -r '.inbounds[0].listen_port' /etc/sing-box/config.json 2>/dev/null)
        local sni=$(jq -r '.inbounds[0].tls.server_name' /etc/sing-box/config.json 2>/dev/null)
        local pbk=$(cat /etc/sing-box/reality-keypair.txt | grep "PublicKey" | awk -F': ' '{print $2}')
        local sid=$(jq -r '.inbounds[0].tls.reality.short_id[0]' /etc/sing-box/config.json 2>/dev/null)

        if [[ -z "$username" || -z "$password" || -z "$port" ]]; then
            log_error "Failed to read AnyTLS parameters from config"
            return 1
        fi

        local server_addr="${SERVER_ADDR:-localhost}"
        local anytls_url="anytls://${password}@${server_addr}:${port}?sni=${sni}&fp=chrome&pbk=${pbk}&sid=${sid}&#SingBox-AnyTLS"

        echo ""
        echo -e "${GREEN}════════════════════════════════════════════════════════${NC}"
        echo -e "${GREEN}AnyTLS Subscription Link${NC}"
        echo -e "${GREEN}════════════════════════════════════════════════════════${NC}"
        echo ""
        echo "Link: $anytls_url"
        echo ""
        echo "Details:"
        echo "  • Username: $username"
        echo "  • Password: $password"
        echo "  • Port: $port"
        echo "  • Server: $server_addr"
        echo "  • SNI: $sni"
        echo "  • Public key (pbk): $pbk"
        echo "  • Short ID (sid): $sid"
        echo "  • Fake site (reality): $fake_site:$fake_site_port"
        echo ""

        if command -v qrencode &> /dev/null; then
            echo "$anytls_url" | qrencode -t ANSI256
        fi

        echo "$anytls_url" > /etc/sing-box/anytls-subscription.txt
        log_success "AnyTLS subscription generated and saved to /etc/sing-box/anytls-subscription.txt"
    fi

    echo ""
}

setup_sing_box_service() {
    log_info "Configuring sing-box systemd service..."

    if [[ ! -d /etc/sing-box ]]; then
        log_warn "Directory /etc/sing-box not found, skipping service configuration"
        return 0
    fi

    local service_file="/etc/systemd/system/sing-box.service"

    if [[ ! -f "$service_file" ]]; then
        log_info "Creating sing-box systemd service file..."
        cat > "$service_file" << 'SYSTEMD_EOF'
[Unit]
Description=sing-box service
Documentation=https://sing-box.sagernet.org
After=network.target nss-lookup.target network-online.target

[Service]
User=sing-box
StateDirectory=sing-box
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
ExecStart=/usr/bin/sing-box -D /var/lib/sing-box -c /etc/sing-box/config.json run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
LimitNOFILE=infinity
Type=simple

[Install]
WantedBy=multi-user.target
SYSTEMD_EOF
        chmod 644 "$service_file"
        systemctl daemon-reload >> "$LOG_FILE" 2>&1
        log_success "sing-box service file created"
    else
        log_info "sing-box service file already exists (skipped)"
    fi

    if [[ -f /etc/sing-box/config.json ]]; then
        local log_file=$(jq -r '.log.output' /etc/sing-box/config.json 2>/dev/null || echo "")
        if [[ -n "$log_file" ]]; then
            touch "$log_file" 2>/dev/null || true
            chown sing-box:sing-box "$log_file" 2>/dev/null || true
            log_info "Log file configured: $log_file"
        fi
    fi
    
    chown root:root "$service_file" 2>/dev/null || true

    read -p "Enable and start sing-box service? (Y/n) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        log_info "Enabling sing-box autostart..."
        if systemctl enable sing-box >> "$LOG_FILE" 2>&1; then
            log_info "sing-box enabled for autostart"
        else
            log_warn "Failed to enable sing-box autostart"
        fi

        log_info "Starting sing-box service..."
        if systemctl start sing-box >> "$LOG_FILE" 2>&1; then
            log_info "sing-box start command sent"
            sleep 2
            if systemctl is-active --quiet sing-box; then
                log_success "sing-box service is running"
            else
                log_error "sing-box service failed to run"
                log_info "Run 'journalctl -u sing-box -n 50' to view logs"
                return 1
            fi
        else
            log_error "Failed to start sing-box service"
            log_info "Check configuration under /etc/sing-box/"
            return 1
        fi
    else
        log_info "sing-box service start skipped by user"
    fi
}

setup_permissions() {
    log_info "Setting file permissions..."

    if [[ "${SELF_BACKEND}" == "true" ]]; then
        chown -R www-data:www-data /var/www/html 2>/dev/null || true
        chmod -R 755 /var/www/html
        log_info "Web root permissions set"

        chown -R www-data:www-data /var/log/nginx 2>/dev/null || true
        chmod -R 755 /var/log/nginx
        log_info "Nginx logs permissions set"

        chmod 644 /etc/nginx/nginx.conf 2>/dev/null || true
        if [[ -f /etc/nginx/ssl/* ]]; then
            chmod 600 /etc/nginx/ssl/* 2>/dev/null || true
        fi
        log_info "Nginx config permissions set"
    else
        log_info "SELF_BACKEND is false, skipping nginx permissions"
    fi

    log_success "Permissions configured"
}

run_installation() {
    confirm_startup_configuration
    print_header
    echo -e "${BLUE}Installation Wizard${NC}"
    echo ""
    
    echo -e "${YELLOW}⚠️  This script will install and configure services on your system.${NC}"
    echo ""
    echo "About to install:"
    echo "  • curl, wget, ca-certificates, openssl, jq, qrencode"
    if [[ "${SELF_BACKEND}" == "true" ]]; then
        echo "  • nginx (reverse proxy)"
    fi
    echo "  • sing-box (proxy server)"
    echo ""
    read -p "Do you want to continue with the installation? (Y/n): " -n 1 -r
    echo ""
    
    if [[ "$ENABLE_WARPPLUS" == "true" ]]; then
    WRAPPLUS_OUTBOUND='{
            "type": "socks",
            "tag": "warpplus-out",
            "server": "127.0.0.1",
            "server_port": 40000,
            "version": "5",
            "username": null,
            "password": null,
            "network": "tcp",
            "udp_over_tcp": true
        },'
    else
        # WRAPPLUS_OUTBOUND is empty when not enabled.
        # fake outbound
        WRAPPLUS_OUTBOUND='{
            "type": "warpplus-out",
            "tag": "direct"
        },'
    fi
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}Installation cancelled by user${NC}"
        return 0
    fi
    echo ""

    echo "Installation log: $LOG_FILE"
    echo ""
    
    check_system
    update_package_manager
    install_dependencies
    create_sing_box_user
    create_directories
    install_config_files
    setup_ssl_certificates
    install_wrapplus
    install_sing_box
    generate_sg_config
    validate_nginx_config
    setup_permissions
    setup_nginx_service
    
    if [[ -n "$PROTOCOL_TYPE" ]]; then
        generate_subscription
        touch /etc/sing-box/installation_complete.flag
        log_success "Installation completed successfully"
    fi

    pause_menu
}

