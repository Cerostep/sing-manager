# ============================================================================
# Management menu functions
# ============================================================================
show_sing_box_status() {
    print_header
    echo -e "${BLUE}📊 Sing-box Service Status${NC}"
    echo ""
    
    if ! command -v sing-box &> /dev/null; then
        print_error "sing-box is not installed"
        pause_menu
        return 1
    fi
    
    echo -e "${BLUE}Service Status:${NC}"
    if systemctl is-active --quiet sing-box >> "$LOG_FILE" 2>&1; then
        print_success "Running"
    else
        print_warn "Not running"
    fi
    echo ""
    
    echo -e "${BLUE}Installed Version:${NC}"
    local version
    if ! version=$(sing-box version 2>> "$LOG_FILE"); then
        print_error "Could not read sing-box version"
    else
        printf '%s\n' "$version"
    fi
    echo ""
    
    echo -e "${BLUE}Autostart Status:${NC}"
    if systemctl is-enabled sing-box &> /dev/null; then
        print_success "Enabled for autostart"
    else
        print_warn "Disabled for autostart"
    fi
    echo ""
    
    echo -e "${BLUE}Configuration Status:${NC}"
    if [[ -f /etc/sing-box/config.json ]]; then
        print_success "Configuration file exists"
        echo "  Location: /etc/sing-box/config.json"
        
        local protocol=$(jq -r '.inbounds[0].type' /etc/sing-box/config.json 2>/dev/null)
        echo "  Protocol: $protocol"
    else
        print_error "Configuration file not found"
    fi
    echo ""
    
    pause_menu
}

display_subscription_qr() {
    print_header
    echo -e "${BLUE}📲 Subscription Information${NC}"
    echo ""

    if [[ ! -f /etc/sing-box/vless-subscription.txt ]]; then
        print_error "No VLESS subscription file found"
        echo "Run installation first to generate the subscription link"
        pause_menu
        return 1
    fi

    local vless_url
    IFS= read -r vless_url < /etc/sing-box/vless-subscription.txt
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}VLESS Protocol${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "Subscription Link:"
    echo "$vless_url"
    echo ""

    if command -v qrencode &> /dev/null; then
        if generate_qr_svg "$vless_url" /etc/sing-box/vless-qr.svg; then
            echo "QR Code: /etc/sing-box/vless-qr.svg"
            echo "$vless_url" | qrencode -t ANSIUTF8 -m 1 -l L
        else
            print_error "Failed to generate the QR code"
        fi
    else
        print_warn "qrencode is not installed; showing the text link only"
    fi

    echo "Details:"
    local uuid server
    uuid=$(echo "$vless_url" | grep -oP '(?<=vless://)[^@]+')
    server=$(echo "$vless_url" | grep -oP '(?<=@)[^?]+')
    echo "  • UUID: $uuid"
    echo "  • Server: $server"
    echo ""
    pause_menu
}

manage_sing_box_config() {
    print_header
    echo -e "${BLUE}⚙️  Sing-box Configuration Management${NC}"
    echo ""
    
    if [[ ! -f /etc/sing-box/config.json ]]; then
        print_error "Configuration file not found: /etc/sing-box/config.json"
        pause_menu
        return 1
    fi
    
    echo -e "${CYAN}Sing-box Configuration Options${NC}"
    echo ""
    echo -e "  ${GREEN}1${NC}) View configuration file"
    echo -e "  ${GREEN}2${NC}) Edit configuration file"
    echo -e "  ${GREEN}3${NC}) Validate configuration"
    echo -e "  ${GREEN}4${NC}) View configuration structure"
    echo -e "  ${GREEN}5${NC}) Back to main menu"
    echo ""
    
    read -p "Choose an option (1-5): " choice
    echo ""
    
    case $choice in
        1)
            print_info "Displaying /etc/sing-box/config.json"
            echo ""
            cat /etc/sing-box/config.json | jq '.' 2>/dev/null || cat /etc/sing-box/config.json
            ;;
        2)
            print_info "Opening editor for /etc/sing-box/config.json"
            echo ""
            if command -v nano &> /dev/null; then
                nano /etc/sing-box/config.json
            elif command -v vi &> /dev/null; then
                vi /etc/sing-box/config.json
            else
                print_error "No text editor found (nano or vi required)"
                pause_menu
                return 1
            fi
            
            print_info "Validating configuration..."
            if sing-box check -c /etc/sing-box/config.json &> /dev/null; then
                print_success "Configuration is valid"
            else
                print_error "Configuration has errors"
                echo "Run: sing-box check -c /etc/sing-box/config.json"
            fi
            ;;
        3)
            print_info "Validating configuration..."
            echo ""
            if sing-box check -c /etc/sing-box/config.json; then
                print_success "Configuration is valid"
            else
                print_error "Configuration validation failed"
            fi
            ;;
        4)
            print_info "Configuration structure:"
            echo ""
            cat /etc/sing-box/config.json | jq 'keys' 2>/dev/null || echo "Failed to parse configuration"
            ;;
        5)
            return 0
            ;;
        *)
            print_error "Invalid option"
            ;;
    esac
    
    pause_menu
    manage_sing_box_config
}

service_control() {
    local service_choice

    while true; do
        print_header
        echo -e "${BLUE}🎮 Service Control${NC}"
        echo ""
        echo -e "${CYAN}Select Service${NC}"
        echo ""
        echo -e "  ${GREEN}1${NC}) Sing-box service"
        echo -e "  ${GREEN}2${NC}) Nginx service"
        echo -e "  ${GREEN}3${NC}) Both services"
        echo -e "  ${GREEN}4${NC}) Back to main menu"
        echo ""

        read -p "Choose service (1-4, Enter to return): " service_choice
        echo ""

        case $service_choice in
            "")
                return 0
                ;;
            1)
                show_service_actions "sing-box"
                ;;
            2)
                if command -v nginx &> /dev/null; then
                    show_service_actions "nginx"
                else
                    print_warn "Nginx is not installed"
                    pause_menu
                fi
                ;;
            3)
                show_service_actions "sing-box"
                if command -v nginx &> /dev/null; then
                    show_service_actions "nginx"
                else
                    print_warn "Nginx is not installed"
                    pause_menu
                fi
                ;;
            4)
                return 0
                ;;
            *)
                print_error "Invalid option"
                pause_menu
                ;;
        esac
    done
}

show_service_actions() {
    local service=$1

    while true; do
        echo -e "${CYAN}$service Service Actions${NC}"
        echo ""
        echo -e "  ${GREEN}1${NC}) Status"
        echo -e "  ${GREEN}2${NC}) Start"
        echo -e "  ${GREEN}3${NC}) Stop"
        echo -e "  ${GREEN}4${NC}) Restart"
        echo -e "  ${GREEN}5${NC}) Enable autostart"
        echo -e "  ${GREEN}6${NC}) Disable autostart"
        echo -e "  ${GREEN}7${NC}) Back to service selection"
        echo ""

        read -p "Choose action (1-8, Enter to return): " action
        echo ""

        case $action in
            ""|8)
                return 0
                ;;
            1)
                if systemctl is-active --quiet "$service" >> "$LOG_FILE" 2>&1; then
                    print_success "$service is running"
                else
                    print_warn "$service is not running"
                fi
                ;;
            2)
                print_info "Starting $service..."
                run_logged systemctl start "$service" && print_success "$service started" || print_error "Failed to start $service"
                ;;
            3)
                print_info "Stopping $service..."
                run_logged systemctl stop "$service" && print_success "$service stopped" || print_error "Failed to stop $service"
                ;;
            4)
                print_info "Restarting $service..."
                run_logged systemctl restart "$service" && print_success "$service restarted" || print_error "Failed to restart $service"
                ;;
            5)
                print_info "Enabling $service autostart..."
                run_logged systemctl enable "$service" && print_success "$service autostart enabled" || print_error "Failed to enable autostart"
                ;;
            6)
                print_info "Disabling $service autostart..."
                run_logged systemctl disable "$service" && print_success "$service autostart disabled" || print_error "Failed to disable autostart"
                ;;
            7)
                print_info "Returning to service selection..."
                return 0
                ;;
            *)
                print_error "Invalid action"
                ;;
        esac
        echo ""
    done
}


main_loop() {
    while true; do
        print_header
        print_menu
        
        read -p "Choose an option (0-4): " choice
        echo ""
        
        case $choice in
            0)
                run_installation
                ;;
            1)
                show_sing_box_status
                ;;
            2)
                display_subscription_qr
                ;;
            3)
                service_control
                ;;
            4)
                print_info "Exiting..."
                echo ""
                exit 0
                ;;
            *)
                print_error "Invalid option. Please try again."
                sleep 1
                ;;
        esac
    done
}

# ============================================================================
# Script entry point
# ============================================================================
trap 'log_error "Operation failed at line $LINENO"; exit 1' ERR

check_root
main_loop
